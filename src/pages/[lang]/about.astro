---
import Layout from '../../layouts/Layout.astro';
import { profile, languages, type Lang } from '../../data/profile';
export function getStaticPaths() { return languages.map(lang => ({ params: { lang } })); }
const lang = Astro.params.lang as Lang;
const zh = lang === 'zh';
---
<Layout lang={lang} title={zh ? '关于' : 'About'} path="about/">
  <section class="wrap page-intro about-intro">
    <div><p class="eyebrow">ABOUT / {profile.name[lang]}</p><h1>{zh ? '你好，我是' : 'Hello, I’m'}<br /><span class="name-heading">{profile.name[lang]}.</span></h1></div>
    <div class="about-bio"><h2>{profile.role[lang]}</h2><p class="lede">{profile.bio[lang]}</p><div class="actions"><a class="button button-dark" href={profile.github}>GitHub <span aria-hidden="true">↗</span></a>{profile.email && <a class="button button-outline" href={'mailto:' + profile.email}>{zh ? '邮件联系' : 'Email me'}</a>}{profile.resume[lang] && <a class="button button-outline" href={profile.resume[lang]}>{zh ? '查看简历' : 'View résumé'} <span aria-hidden="true">↗</span></a>}</div></div>
  </section>
  <section class="wrap section about-principles">
    <div><p class="eyebrow">01 / FOCUS</p><h2>{zh ? '从界面到工程' : 'From interfaces to engineering'}</h2><p>{zh ? '当前公开项目 XUILab 聚焦 Unity UGUI：列表更新、渐变细分，以及可复现的独立 Player 性能测量。' : 'My current public project, XUILab, focuses on Unity UGUI: list updates, gradient subdivision, and reproducible performance measurement in independent Player runs.'}</p></div>
    <div><p class="eyebrow">02 / PROCESS</p><h2>{zh ? '让过程可以复核' : 'Make the process reviewable'}</h2><p>{zh ? '项目资料保留测量协议、全部对照、不确定结论与失败记录。XUILab 由 Agent 参与实现、验证与审查，个人学习与技术交付分别记录。' : 'The project retains measurement protocols, all comparisons, inconclusive outcomes, and failure records. Agents contribute to XUILab implementation, verification, and review; personal learning and technical delivery are recorded separately.'}</p></div>
  </section>
  <section class="wrap contact-section"><div><p class="eyebrow">CONTACT</p><h2>{zh ? '从一个项目开始交流。' : 'Start with a project.'}</h2><p>{zh ? '可以在 GitHub 查看源码与项目讨论。' : 'Explore the code and project discussions on GitHub.'}</p></div><a class="text-link" href={profile.github}>{profile.github.replace(/^https?:\/\//, '').replace(/\/$/, '')} <span aria-hidden="true">↗</span></a></section>
</Layout>
