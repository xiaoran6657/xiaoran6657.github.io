---
import Layout from '../../layouts/Layout.astro';
import { profile, languages, type Lang } from '../../data/profile';
export function getStaticPaths() { return languages.map(lang => ({ params: { lang } })); }
const lang = Astro.params.lang as Lang;
const zh = lang === 'zh';
---
<Layout lang={lang} title={zh ? '关于' : 'About'} path="about/">
  <section class="wrap page-intro about-intro">
    <div><p class="eyebrow">ABOUT / {profile.name[lang]}</p><h1>{zh ? '你好，我是' : 'Hello, I’m'}<br /><span class="name-heading">{profile.name[lang]}.</span></h1></div>
    <div class="about-bio"><h2>{profile.role[lang]}</h2><p class="lede">{profile.bio[lang]}</p><div class="actions"><a class="button button-dark" href={profile.github}>GitHub <span aria-hidden="true">↗</span></a>{profile.email && <a class="button button-outline" href={'mailto:' + profile.email}>{zh ? '邮件联系' : 'Email me'}</a>}{profile.resume[lang] && <a class="button button-outline" href={profile.resume[lang]}>{zh ? '查看简历' : 'View résumé'} <span aria-hidden="true">↗</span></a>}</div></div>
  </section>
  <section class="wrap section about-principles">
    <div><p class="eyebrow">01 / FOCUS</p><h2>{zh ? '从游戏客户端到渲染底层' : 'From game clients to rendering systems'}</h2><p>{zh ? 'LumaBough 探索 C++20 双后端渲染架构、资源生命周期与证据化验证；开源项目 XUILab 聚焦 Unity UGUI 与可复现测量；非开源团队项目 BattleWall 展示我在客户端 gameplay、载具交互和联机同步方面的参与经历。' : 'LumaBough explores C++20 rendering architecture, resource lifetimes, and evidence across two backends. XUILab is my open-source exploration of Unity UGUI and reproducible measurement. BattleWall is a closed-source team project showcasing my contributions to client gameplay, vehicle interaction, and networking.'}</p></div>
    <div><p class="eyebrow">02 / PROCESS</p><h2>{zh ? '让过程可以复核' : 'Make the process reviewable'}</h2><p>{zh ? 'XUILab 的资料保留测量协议、全部对照、不确定结论与失败记录。XUILab 由 Agent 参与实现、验证与审查，个人学习与技术交付分别记录。' : 'XUILab retains measurement protocols, all comparisons, inconclusive outcomes, and failure records. Agents contribute to XUILab implementation, verification, and review; personal learning and technical delivery are recorded separately.'}</p></div>
  </section>
  <section class="wrap contact-section" id="contact"><div><p class="eyebrow">CONTACT</p><h2>{zh ? '从一个项目开始交流。' : 'Start with a project.'}</h2><p>{zh ? '可以在 GitHub 查看源码与项目讨论。' : 'Explore the code and project discussions on GitHub.'}</p></div><div class="contact-details">{profile.phone && <a class="text-link" href={'tel:' + profile.phone}>{zh ? '电话：' : 'Phone: '}{profile.phone}</a>}{profile.email && <a class="text-link" href={'mailto:' + profile.email}>{profile.email}</a>}<a class="text-link" href={profile.github}>{profile.github.replace(/^https?:\/\//, '').replace(/\/$/, '')} <span aria-hidden="true">↗</span></a></div></section>
</Layout>
