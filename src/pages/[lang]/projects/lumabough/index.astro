---
import Layout from '../../../../layouts/Layout.astro';
import LumaBoughArchive from '../../../../components/LumaBoughArchive.astro';
import ShadowLabFigure from '../../../../components/ShadowLabFigure.astro';
import { languages, type Lang } from '../../../../data/profile';
import { lumabough, lumaboughArchive } from '../../../../data/lumabough';
import { showcasePresets as presets } from '../../../../data/lumabough-showcase';
export function getStaticPaths() { return languages.map(lang => ({ params: { lang } })); }
const lang = Astro.params.lang as Lang;
const zh = lang === 'zh';
const command = '.\\LightingShowcase.exe --scene shadow-bench --shadow pcss --light-size 0.65 --bias 0.004 --samples 64 --indirect direct --width 960 --height 600 --output runs/pcss';
---
<Layout lang={lang} title={zh ? 'LumaBough · 软阴影与光照实验' : 'LumaBough · Soft shadows & lighting'} description={lumabough.summary[lang]} path="projects/lumabough/">
  <section class="wrap project-intro">
    <a class="back-link" href={'/' + lang + '/projects/'}>← {zh ? '全部作品' : 'All projects'}</a>
    <div class="project-title lumabough-title"><div><p class="eyebrow">03 / SHADOW &amp; LIGHTING LAB</p><h1>LumaBough<span class="title-period">.</span></h1></div><span class="badge">MIT · {lumabough.tag}</span></div>
    <div class="project-description"><h2>{zh ? '光枝 · 软阴影与光照实验' : 'Soft-shadow and lighting experiments'}</h2><p class="lede">{lumabough.summary[lang]}</p></div>
    <div class="actions"><a class="button button-dark" href="#shadow-methods">{zh ? '查看阴影对照' : 'Compare shadows'} ↓</a><a class="button button-outline" href={lumabough.repo}>GitHub ↗</a><a class="button button-outline" href={lumabough.release}>{zh ? '源码与运行包' : 'Source & runtime'} ↗</a></div>
    <p class="video-note">{zh ? 'MiniEngine 的独立公开作品库，展示名称为 LumaBough。Agent 参与实现、图像采集、验证与文档整理；技术交付和个人学习分别记录。' : 'The independent public portfolio repository for MiniEngine, presented as LumaBough. Agents contribute to implementation, image capture, verification, and documentation. Technical delivery and personal learning are recorded separately.'}</p>
  </section>

  <section class="wrap project-facts" aria-label={zh ? '本版展示范围' : 'Showcase scope'}>
    <div><span class="eyebrow">PLATFORM</span><strong>Windows x64 / C++20</strong></div>
    <div><span class="eyebrow">BACKEND</span><strong>Native D3D12 / HLSL</strong></div>
    <div><span class="eyebrow">SHADOWS</span><strong>Hard / PCF / PCSS</strong></div>
    <div><span class="eyebrow">OUTPUT</span><strong>{zh ? '离屏图片 · 线性数据 · JSON' : 'Offscreen images · Linear data · JSON'}</strong></div>
  </section>

  <nav class="wrap lumabough-nav" aria-label={zh ? '本页内容' : 'On this page'}>
    <a href="#shadow-methods">01 / {zh ? '阴影方法' : 'Shadow methods'}</a><a href="#parameters">02 / {zh ? '参数对照' : 'Parameters'}</a><a href="#cornell">03 / {zh ? '一次反弹' : 'One bounce'}</a><a href="#reproduce">04 / {zh ? '复现与来源' : 'Reproduction'}</a><a href="#history">05 / {zh ? '历史工程资料' : 'Earlier engineering work'}</a>
  </nav>

  <section class="wrap section" id="shadow-methods">
    <div class="section-heading"><div><p class="eyebrow">01 / SHADOW METHODS</p><h2>{zh ? '同一场景，比较硬阴影、PCF 与 PCSS。' : 'One scene: hard shadows, PCF, and PCSS.'}</h2></div></div>
    <div class="lumabough-reading"><p class="lede">{zh ? '测试台放置不同高度的方块与细遮挡物。固定相机、几何、光源位置和输出变换，只切换阴影方法，重点观察接触处、悬空阴影与过渡带。' : 'The bench contains boxes at different heights and thin occluders. Camera, geometry, light position, and output transform stay fixed while the shadow method changes. Inspect contact regions, elevated shadows, and transition bands.'}</p></div>
    <div class="shadow-lab-grid shadow-lab-methods">{[presets.hard, presets.pcf, presets.pcss].map(preset => <ShadowLabFigure lang={lang} preset={preset} />)}</div>
    <div class="lumabough-reading">
      <h3>{zh ? '实现中的三个步骤' : 'Three implementation steps'}</h3>
      <ol class="lumabough-questions">
        <li>{zh ? 'GPU compute 对程序生成的盒子和平面求交，生成 1024×1024 的光源深度图。深度使用沿光轴的线性世界单位。' : 'GPU compute intersects procedural boxes and planes to generate a 1024×1024 light-depth map. Depth uses linear world units along the light axis.'}</li>
        <li>{zh ? 'PCF 对深度比较结果取平均；PCSS 先搜索 blocker，再用平均深度估计过滤半径。采样使用包含中心 tap 的方形 Hammersley 分布。' : 'PCF averages depth-comparison results. PCSS first searches for blockers, then estimates a filter radius from mean blocker depth. Sampling uses a square Hammersley distribution with a center tap.'}</li>
        <li>{zh ? '同一次 GPU 运行同时输出 HDR 和中间量。展示 PNG 统一由线性颜色经 Reinhard 与 sRGB 转换，避免为不同算法分别调整曝光。' : 'The same GPU run outputs HDR color and intermediate values. All display PNGs use the same Reinhard and sRGB conversion, without per-method exposure adjustments.'}</li>
      </ol>
      <div class="limit-note"><strong>{zh ? '一次实际定位：墙面上的错误条带' : 'A debugging case: false bands on a wall'}</strong><p>{zh ? '初版把中心接收点深度用于整组采样，Cornell 墙面自身的深度梯度被误判成 blocker。修正后，在每个实际读取的 shadow texel 中心求光线与接收平面的交点，再执行深度比较和显式 bias；没有用不断增大 bias 掩盖问题。半影宽度仍采用平行接收平面近似。' : 'The first version reused the center receiver depth for every tap, misclassifying the Cornell wall’s own depth gradient as blockers. The corrected path intersects the light ray at each sampled shadow-texel center with the receiver plane before applying the explicit bias and depth comparison. Penumbra width still uses the parallel-receiver approximation.'}</p></div>
      <p class="video-note">{zh ? '这是固定教学几何上的独立离屏实验入口，不是通用 mesh 光栅场景、实时交互演示或完整面积光源积分。光源尺寸只改变阴影 visibility，直接光采用强度固定的中心点代理。' : 'This is a standalone offscreen experiment on fixed teaching geometry, rather than a general mesh-rasterization scene, an interactive real-time demo, or a full area-light integral. Light size changes shadow visibility; direct light uses a fixed-intensity center-point proxy.'}</p>
      <ShadowLabFigure lang={lang} preset={presets.diagnostic} />
    </div>
  </section>

  <section class="wrap section" id="parameters">
    <div class="section-heading"><div><p class="eyebrow">02 / PARAMETERS &amp; FAILURE CASES</p><h2>{zh ? '一次改一个参数，保留效果和代价。' : 'Change one parameter and retain the tradeoffs.'}</h2></div></div>
    <div class="lumabough-reading"><p>{zh ? '除标题中指出的参数，以下对照均沿用 PCSS 基线：light-size 0.65、bias 0.004、每阶段 64 taps、960×600。这里的 samples 是每阶段预算：PCSS 有 blocker 搜索与过滤两个阶段，不能把它与 PCF 的相同数值当作相同总开销。' : 'Except for the parameter named in each heading, comparisons use the PCSS baseline: light-size 0.65, bias 0.004, 64 taps per phase, and 960×600. Samples is a per-phase budget. PCSS performs both blocker search and filtering, so the same number does not imply the same total work as PCF.'}</p></div>
    <article class="shadow-lab-comparison"><h3>{zh ? '光源尺寸与半影' : 'Light size and penumbrae'}</h3><div class="shadow-lab-grid">{[presets.lightSmall, presets.lightLarge].map(preset => <ShadowLabFigure lang={lang} preset={preset} />)}</div></article>
    <article class="shadow-lab-comparison"><h3>{zh ? 'bias 与接触处误差' : 'Bias and contact errors'}</h3><div class="shadow-lab-grid">{[presets.pcss, presets.biasHigh].map(preset => <ShadowLabFigure lang={lang} preset={preset} />)}</div></article>
    <article class="shadow-lab-comparison"><h3>{zh ? '采样预算与过渡质量' : 'Sampling budget and transition quality'}</h3><div class="shadow-lab-grid">{[presets.samplesLow, presets.pcss].map(preset => <ShadowLabFigure lang={lang} preset={preset} />)}</div></article>
    <div class="lumabough-reading limit-note"><strong>{zh ? '当前结论的边界' : 'Limits of these comparisons'}</strong><p>{zh ? '本页展示静态效果和参数响应，不给出 FPS、时间稳定性或加速比例。运行回执中的单次 GPU 时间覆盖深度图生成与着色，排除初始化、读回和 PNG 编码；冷启动单次计时不能作为性能基准。' : 'These stills show appearance and parameter response, without FPS, temporal-stability, or speedup claims. The receipt’s single GPU time covers depth-map generation and shading, excluding initialization, readback, and PNG encoding. A single cold measurement is not a benchmark.'}</p></div>
  </section>

  <section class="wrap section" id="cornell">
    <div class="section-heading"><div><p class="eyebrow">03 / ONE DIFFUSE BOUNCE</p><h2>{zh ? '红绿墙、白盒与一次反弹。' : 'Colored walls, white boxes, and one bounce.'}</h2></div></div>
    <div class="lumabough-reading"><p class="lede">{zh ? '保留同一相机、材质、直接光与 PCSS 参数，仅启用或关闭一次 Lambert 漫反射反弹。观察暗部和白色表面附近的颜色变化。' : 'Camera, materials, direct light, and PCSS settings stay fixed. Only one Lambertian diffuse bounce is toggled. Inspect dark regions and color changes near white surfaces.'}</p></div>
    <div class="shadow-lab-grid">{[presets.cornellDirect, presets.cornellBounce].map(preset => <ShadowLabFigure lang={lang} preset={preset} />)}</div>
  </section>

  <section class="wrap section lumabough-reading" id="reproduce">
    <p class="eyebrow">04 / REPRODUCTION &amp; SOURCES</p><h2>{zh ? '按预设复现同一张图。' : 'Reproduce an image from its preset.'}</h2>
    <ol class="lumabough-questions">
      <li>{zh ? '从固定 Release 下载 Windows x64 运行包并核对 SHA-256，解压后按包内运行说明执行。程序正常运行不依赖 Python。' : 'Download the Windows x64 runtime from the pinned Release, verify SHA-256, extract it, and follow its run guide. Normal execution does not require Python.'}</li>
      <li>{zh ? '输出目录必须是新目录。运行会一并写出颜色图、visibility、诊断图、线性数据和 JSON；重新运行使用另一个目录，避免覆盖旧结果。' : 'Use a new output directory. A run writes color, visibility, diagnostics, linear data, and JSON together. Choose another directory for a repeat run to preserve earlier results.'}</li>
      <li>{zh ? '核对清单中的场景、参数、后端、EXE/shader 身份和图像哈希。跨 GPU 的像素不要求逐位相同，应结合原始中间量与解析锚点检查。' : 'Check the scene, parameters, backend, EXE/shader identities, and image hashes in the manifest. Cross-GPU output is not required to be bit-identical; use raw intermediates and analytic anchors when checking behavior.'}</li>
    </ol>
    <pre class="shadow-lab-command"><code>{command}</code></pre>
    <p><a href={lumabough.source + lumabough.showcase + 'README.md'}>{zh ? '完整运行说明、参数与验证范围' : 'Run guide, parameters & validation scope'}</a> · <a href={lumabough.source + 'shaders/d3d12/LightingShowcase.hlsl'}>HLSL</a> · <a href={lumabough.source + 'samples/lighting_lab/LightingShowcase.cpp'}>C++</a> · <a href="/media/lumabough/shadow-lab/manifest.json">{zh ? '网站媒体 SHA-256' : 'Website media SHA-256'}</a></p>
    <p class="video-note">{zh ? '本版展示限定原生 D3D12。程序生成的几何和材质属于项目；Cornell 风格场景未导入课程作业源码、Cornell 标定数据或第三方模型。源码与项目自有图片适用 MIT，其他历史素材保留各自许可。' : 'This showcase is limited to native D3D12. Geometry and materials are generated by the project. The Cornell-style room does not import coursework source, calibrated Cornell data, or third-party models. Project-owned source and images use MIT; older third-party media retain their licenses.'}</p>
    <div class="actions"><a class="button button-dark" href={lumabough.release}>{zh ? '下载并运行' : 'Download & run'} ↗</a><a class="button button-outline" href={lumabough.source + lumabough.showcase + 'README.md'}>{zh ? '阅读实验说明' : 'Read the experiment guide'} ↗</a></div>
  </section>

  <section class="wrap section" id="history">
    <p class="eyebrow">05 / EARLIER ENGINEERING WORK</p><h2>{zh ? '渲染框架与早期公开资料。' : 'Rendering framework and earlier public work.'}</h2>
    <p>{zh ? '软阴影实验建立在已有 C++ 工程之上。下面保留早期双后端架构、视频与性能材料，继续固定在 v0.1.0-preview；这些历史验证不替代当前阴影实验的验证。' : 'The shadow lab builds on the existing C++ project. Earlier architecture, dual-backend videos, and performance records remain pinned to v0.1.0-preview. Their historical validation does not replace validation of the current shadow lab.'}</p>
    <details class="shadow-lab-history"><summary>{zh ? '展开双后端、资源管理与历史实验' : 'Expand backends, resource management & historical experiments'} · {lumaboughArchive.tag}</summary><LumaBoughArchive lang={lang} /></details>
  </section>
</Layout>
<style>
  .shadow-lab-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem; }
  .shadow-lab-methods { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .shadow-lab-comparison { margin-top: 2.5rem; }
  .shadow-lab-comparison > h3 { font-size: 1.35rem; }
  .shadow-lab-command { overflow-x: auto; padding: 1.25rem; margin: 1.5rem 0; background: var(--surface-2); border: 1px solid var(--line); border-radius: 5px; font-size: .8rem; }
  .shadow-lab-history { border-top: 1px solid var(--line); margin-top: 1.5rem; padding-top: 1.5rem; }
  .shadow-lab-history > summary { cursor: pointer; padding: .7rem 0; font-weight: 600; }
  .shadow-lab-history > summary:focus-visible { outline: 2px solid var(--text); outline-offset: 4px; }
  @media (max-width: 960px) { .shadow-lab-methods { grid-template-columns: 1fr; } }
  @media (max-width: 760px) { .shadow-lab-grid { grid-template-columns: 1fr; gap: .5rem; } }
</style>
