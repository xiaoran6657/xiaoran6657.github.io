---
import Layout from '../../../../layouts/Layout.astro';
import { languages, type Lang } from '../../../../data/profile';
import { battlewall, contributions } from '../../../../data/battlewall';
export function getStaticPaths() { return languages.map(lang => ({ params: { lang } })); }
const lang = Astro.params.lang as Lang;
const zh = lang === 'zh';
---
<Layout lang={lang} title="BattleWall" description={battlewall.summary[lang]} path="projects/battlewall/">
  <section class="wrap project-intro">
    <a class="back-link" href={'/' + lang + '/projects/'}>← {zh ? '全部作品' : 'All projects'}</a>
    <div class="project-title battlewall-title"><div><p class="eyebrow">02 / UNITY GAMEPLAY</p><h1>BattleWall<span class="title-period">.</span></h1></div><span class="badge">{zh ? '团队项目 · 非开源' : 'Team project · Closed source'}</span></div>
    <div class="project-description"><h2>{battlewall.subtitle[lang]}</h2><p class="lede">{battlewall.summary[lang]}</p></div>
    <div class="actions"><a class="button button-dark" href="#demo">{zh ? '观看游戏演示' : 'Watch the gameplay demo'} ↓</a><a class="button button-outline" href="#contributions">{zh ? '我的参与工作' : 'My contributions'} ↓</a></div>
    <p class="battlewall-notice">{battlewall.notice[lang]}</p>
  </section>
  <section class="wrap project-facts" aria-label={zh ? '项目概况' : 'Project overview'}>
    <div><span class="eyebrow">{zh ? '项目类型' : 'PROJECT'}</span><strong>{zh ? '多人合作 PvPvE' : 'Multiplayer co-op PvPvE'}</strong></div>
    <div><span class="eyebrow">{zh ? '参与方向' : 'CONTRIBUTION'}</span><strong>{zh ? '客户端 Gameplay' : 'Client-side gameplay'}</strong></div>
    <div><span class="eyebrow">STACK</span><strong>Unity / C# / Entitas ECS</strong></div>
    <div><span class="eyebrow">NETWORK</span><strong>Netcode for GameObjects</strong></div>
  </section>
  <section class="wrap section" id="demo">
    <div class="section-heading"><div><p class="eyebrow">GAMEPLAY DEMO</p><h2>{zh ? '走进攻城战场' : 'Into the siege'}</h2></div></div>
    <div class="video-frame"><video controls playsinline preload="none" poster="/media/battlewall/poster.jpg" width="1280" height="720" aria-label={zh ? 'BattleWall 游戏完整演示' : 'BattleWall full gameplay demonstration'} aria-describedby="demo-note">
      <source src="/media/battlewall/demo.mp4" type="video/mp4" />
      <p>{zh ? '浏览器无法播放此视频。' : 'Your browser cannot play this video.'}<a href="/media/battlewall/demo.mp4">{zh ? '打开演示视频' : 'Open demo video'}</a></p>
    </video></div>
    <p class="video-note" id="demo-note">{zh ? '约 2 分 45 秒的游戏演示。网页版本裁切保留左侧游戏画面，隐藏编辑器、工程目录与日志；完整时长、顺序、速度和原音轨保留。画面用于展示游戏，不作为网络同步正确性或性能测量的证明。' : 'Approximately 2 minutes 45 seconds of gameplay. The web edit crops to the left-hand gameplay view, omitting the editor, project panels, and logs. Full duration, sequence, speed, and original audio are preserved. The footage illustrates the game; it is not a networking correctness test or performance benchmark.'}</p>
  </section>
  <section class="wrap section" id="contributions">
    <div class="section-heading"><div><p class="eyebrow">MY CONTRIBUTIONS</p><h2>{zh ? '让输入、状态与表现衔接起来' : 'Connecting input, state & presentation'}</h2></div></div>
    <p class="lede">{zh ? '以下按个人参与的客户端工作归纳。游戏本身由团队协作完成，画面中的全部玩法与美术不代表由我独立制作。' : 'The following summarizes my contributions to the client. The game was developed collaboratively; the full gameplay and artwork shown are not presented as my individual work.'}</p>
    <div class="battlewall-contributions">{contributions.map((item, index) => <article>
      <p class="eyebrow">0{index + 1} / GAMEPLAY ENGINEERING</p><h3>{item.title[lang]}</h3>
      <p>{item.problem[lang]}</p><p>{item.work[lang]}</p>
      <p class="muted"><strong>{zh ? '取舍：' : 'Tradeoff: '}</strong>{item.tradeoff[lang]}</p>
    </article>)}</div>
  </section>
  <section class="wrap contact-section"><div><p class="eyebrow">PROJECT NOTES</p><h2>{zh ? '协作经历，公开摘要。' : 'Team experience. Public summary.'}</h2><p>{zh ? '本文根据项目复盘资料整理，保留机制与取舍，不披露源码、内部接口或完整技术文档。游戏及相关素材权利归各自权利人所有，不因本网站源码公开而转为开源授权。' : 'This summary is based on project retrospectives and describes mechanisms and tradeoffs without distributing source code, internal interfaces, or full technical documents. Rights to the game and its media remain with their respective owners; this public website does not grant an open-source license to them.'}</p></div><a class="text-link" href={'/' + lang + '/projects/'}>{zh ? '返回作品列表' : 'Back to projects'} →</a></section>
</Layout>
