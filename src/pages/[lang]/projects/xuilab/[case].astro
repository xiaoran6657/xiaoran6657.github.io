---
import Layout from '../../../../layouts/Layout.astro';
import EvidenceNote from '../../../../components/EvidenceNote.astro';
import { languages, type Lang } from '../../../../data/profile';
import { caseDetails } from '../../../../data/xuilab-details';
import { cases, docs, downloads } from '../../../../data/xuilab';
export function getStaticPaths() { return languages.flatMap(lang => cases.map(item => ({ params: { lang, case: item.slug }, props: { item } }))); }
const lang = Astro.params.lang as Lang;
const { item } = Astro.props;
const zh = lang === 'zh';
const detail = caseDetails[item.slug];
const next = cases[(cases.findIndex(c => c.slug === item.slug) + 1) % cases.length];
---
<Layout lang={lang} title={item.title + ' · XUILab'} description={item.summary[lang]} path={'projects/xuilab/' + item.slug + '/'}>
  <header class="wrap case-intro"><a class="back-link" href={'/' + lang + '/projects/xuilab/'}>← XUILab</a><p class="eyebrow">CASE {item.number} / {item.topic[lang]}</p><h1>{item.title}</h1><p class="lede">{item.summary[lang]}</p></header>
  <div class="wrap case-layout">
    <nav class="case-toc" aria-label={zh ? '本页目录' : 'On this page'}><span class="eyebrow">{zh ? '本页内容' : 'ON THIS PAGE'}</span>
      <a href="#demo">01 / {zh ? '演示' : 'Demo'}</a><a href="#question">02 / {zh ? '问题' : 'Question'}</a><a href="#implementation">03 / {zh ? '实现' : 'Implementation'}</a><a href="#results">04 / {zh ? '结果与限制' : 'Results & limits'}</a><a href="#evidence">05 / {zh ? '图表与证据' : 'Evidence'}</a>
    </nav>
    <article class="case-body">
      <section id="demo">
        <div class="video-frame"><video controls playsinline preload="none" poster={'/media/xuilab/' + item.folder + '/cover.png'} width="1280" height="720" aria-label={item.title + (zh ? ' 技术演示，无音轨' : ' technical demo, no audio')} aria-describedby="video-description">
          <source src={'/media/xuilab/' + item.video + '.mp4'} type="video/mp4" />
          <p>{zh ? '浏览器不支持此视频。' : 'Your browser does not support this video.'}<a href={downloads}>{zh ? '下载演示' : 'Download the demo'}</a></p>
        </video></div>
        <p class="video-note" id="video-description">{zh ? '45 秒 · 无音轨 · 帧驱动技术演示，非实时性能录像。画面诊断数字不作为正式采样结果。' : '45 seconds · No audio · Frame-driven technical demonstration, not real-time performance footage. On-screen diagnostics are not formal measurement results.'}</p>
        <details class="demo-description"><summary>{zh ? '演示内容与时间点' : 'Demo description & timestamps'}</summary><ol>{item.steps[lang].map(step => <li>{step}</li>)}</ol></details>
      </section>
      <section id="question" class="article-section"><p class="eyebrow">02 / QUESTION</p><h2>{zh ? '要回答的问题' : 'The question'}</h2><p class="question-text">{item.question[lang]}</p>{detail.questions.map(block => <div class="case-explanation"><h3>{block.title[lang]}</h3><p>{block.text[lang]}</p></div>)}</section>
      <section id="implementation" class="article-section"><p class="eyebrow">03 / IMPLEMENTATION</p><h2>{zh ? '实现与取舍' : 'Implementation & tradeoffs'}</h2><p>{item.approach[lang]}</p><div class="case-flow"><strong>{zh ? '处理流程' : 'Processing flow'}</strong><p>{detail.flow[lang]}</p></div>{detail.implementation.map(block => <div class="case-explanation"><h3>{block.title[lang]}</h3><p>{block.text[lang]}</p></div>)}<p class="figure-crossref"><a href={item.slug === 'benchmark-runner' ? '#figure-1' : '#figure-3'}>{zh ? '查看下方对应机制图与说明' : 'See the corresponding mechanism figure below'} ↓</a></p></section>
      <section id="results" class="article-section"><p class="eyebrow">04 / RESULTS & LIMITS</p><h2>{zh ? '得到什么，尚不能说明什么' : 'What the results establish'}</h2><p>{item.result[lang]}</p><div class="case-explanation"><h3>{zh ? '实验条件与判定方法' : 'Conditions and decision rules'}</h3><p>{detail.protocol[lang]}</p><p>{detail.rule[lang]}</p></div><div class="case-results-table" role="region" tabindex="0" aria-label={zh ? '完整结果表，可横向滚动' : 'Full results table, horizontally scrollable'}><table><caption>{detail.tableCaption[lang]}</caption><thead><tr>{detail.headers.map(header => <th scope="col">{header[lang]}</th>)}</tr></thead><tbody>{detail.rows.map(row => <tr>{row.map((cell, index) => index === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>)}</tr>)}</tbody></table></div>{detail.results.map(block => <div class="case-explanation"><h3>{block.title[lang]}</h3><p>{block.text[lang]}</p></div>)}<div class="limit-note"><strong>{zh ? '结论边界' : 'Limits'}</strong><p>{item.limit[lang]}</p></div><EvidenceNote lang={lang} /></section>
      <section id="evidence" class="article-section"><p class="eyebrow">05 / EVIDENCE</p><h2>{zh ? '逐图阅读：机制、观察与结论边界' : 'Reading the figures: mechanisms, observations & limits'}</h2><p class="muted">{zh ? '图片来自版本化的 XUILab 展示资料。点击图片查看原尺寸。图内保留原始英文标注。' : 'Images from the versioned XUILab showcase. Open an image at full resolution; original English annotations are retained.'}</p>
        {item.images.map((img, index) => <figure class="evidence-figure" id={'figure-' + (index + 1)}><a href={'/media/xuilab/' + item.folder + '/' + img.file + '.png'} aria-label={img.caption[lang] + (zh ? ' 查看原图' : ' Open full image')}><img src={'/media/xuilab/' + item.folder + '/' + img.file + '.png'} alt={img.caption[lang]} width="1600" height="900" loading="lazy" /></a><figcaption><h3><span class="figure-number">{zh ? '图' : 'Figure'} {index + 1}.</span> {img.caption[lang]}</h3><dl class="figure-reading"><div><dt>{zh ? '如何读图' : 'How to read it'}</dt><dd>{detail.figures[img.file].reading[lang]}</dd></div><div><dt>{zh ? '图中观察' : 'What it shows'}</dt><dd>{detail.figures[img.file].finding[lang]}</dd></div><div><dt>{zh ? '解释边界' : 'Interpretation limits'}</dt><dd>{detail.figures[img.file].limit[lang]}</dd></div></dl><p class="figure-source">{zh ? '来源：' : 'Source: '}<a href={docs + 'Media/' + item.folder + '/' + img.file + '.png'}>XUILab v0.1.0-preview.1 · {img.file}</a> · <a href={docs + item.folder + '/CASE.md'}>{zh ? '对应案例记录' : 'Case record'}</a></p></figcaption></figure>)}
      </section>
      <div class="article-links"><a class="button button-dark" href={docs + item.folder + '/CASE.md'}>{zh ? '核对上游案例与源码' : 'Cross-check the upstream case & source'} ↗</a><a class="text-link" href={docs + 'THIRD_PARTY_NOTICES.md'}>{zh ? '素材许可' : 'Media licenses'} ↗</a></div>
      <a class="next-case" href={'/' + lang + '/projects/xuilab/' + next.slug + '/'}><span class="eyebrow">{zh ? '继续探索' : 'KEEP EXPLORING'}</span><strong>{next.title} <span aria-hidden="true">→</span></strong></a>
    </article>
  </div>
</Layout>
