---
import Layout from '../../../layouts/Layout.astro';
import ProjectFeature from '../../../components/ProjectFeature.astro';
import { languages, type Lang } from '../../../data/profile';
export function getStaticPaths() { return languages.map(lang => ({ params: { lang } })); }
const lang = Astro.params.lang as Lang;
const zh = lang === 'zh';
---
<Layout lang={lang} title={zh ? '作品' : 'Projects'} path="projects/">
  <section class="wrap page-intro"><p class="eyebrow">PROJECT INDEX / 01</p><h1>{zh ? '作品与实验' : 'Projects & experiments'}</h1><p class="lede">{zh ? '从具体问题出发，记录实现、取舍与可以复核的结果。' : 'Starting with specific questions, documenting implementation, tradeoffs, and results that can be checked.'}</p></section>
  <section class="wrap section"><ProjectFeature lang={lang} /></section>
</Layout>
