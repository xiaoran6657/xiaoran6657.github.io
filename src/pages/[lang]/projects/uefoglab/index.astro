---
import Layout from '../../../../layouts/Layout.astro';
import { languages, type Lang } from '../../../../data/profile';
import { uefoglab } from '../../../../data/uefoglab';
export function getStaticPaths() { return languages.map(lang => ({ params: { lang } })); }
const lang = Astro.params.lang as Lang;
const zh = lang === 'zh';
const r = uefoglab.results;
const modes = r.mobile.timing.modes.filter(row => row.name !== 'Off');
const media = '/media/uefoglab/';
const source = uefoglab.source.repository + '/blob/' + uefoglab.source.version + '/';
const desktopShader = source + 'Plugins/UEFog/Shaders/Private/UEFog.usf';
const mobileShader = source + 'Plugins/UEFog/Shaders/Private/UEFogMobileReconstruction.usf';
const quality = [
 { key:'planeWholeTRMSE',zh:'Planes 全图 T RMSE',en:'Planes whole-image T RMSE' },
 { key:'planeStepTRMSE',zh:'平面阶跃边缘 T RMSE',en:'Plane-step edge T RMSE' },
 { key:'nearSkyTRMSE',zh:'近景／天空边界 T RMSE',en:'Near / sky boundary T RMSE' },
 { key:'planeWholeHDRBlueRMSE',zh:'Planes 全图线性 HDR 蓝通道 RMSE',en:'Planes whole-image linear HDR blue RMSE' },
 { key:'thinHitTMAE',zh:'ThinStripe 细条命中区 T MAE',en:'ThinStripe thin-hit T MAE' },
] as const;
const approaches = zh ? [
 ['解析高度雾','随高度变化的全局分布，适合远景与大范围氛围。','方案背景；不是局部 S/T 数值参考。'],
 ['独立 Local Fog Volumes','可摆放球体，结合径向与高度分布。','已做桌面静态对照；独立路径没有 VF 的体积光照／阴影。'],
 ['Volumetric Fog / froxel','视锥三维网格保存介质和照明，可接入灯光、阴影与历史重投影。','已做 LFV 密度注入 VF 的静态对照，没有通用性能排名。'],
 ['本项目：屏幕射线积分','在球域内沿相机射线积分 S/T，再尝试低格重建。','逐环节检查数学、深度、重建、HDR 和一台手机的雾成本。'],
 ['离线体积路径追踪','匹配介质、光照与散射假设后，可作更完整输运参考。','尚未实施同介质桥接，不列为实测。'],
] : [
 ['Analytic height fog','A global height-dependent distribution for distant scenery and broad atmosphere.','Background to the choice; not a local S/T numerical reference.'],
 ['Standalone Local Fog Volumes','Placeable spheres combining radial and height distributions.','Compared in desktop stills; the standalone path lacks VF volumetric lighting/shadows.'],
 ['Volumetric Fog / froxels','A 3D frustum grid stores medium and lighting; lights, shadows and temporal reprojection are available.','LFV density injected into VF is compared in stills, without a general performance ranking.'],
 ['This project: screen-ray integration','Integrate camera rays inside a sphere, store S/T, then try a smaller fog grid.','Separately inspect math, depth, reconstruction, HDR and one-device fog cost.'],
 ['Offline volume path tracing','A fuller transport reference once medium, lighting and scattering assumptions match.','A matched-medium bridge is not implemented or measured.'],
];
const pipeline = zh ? [
 ['生成射线','全分辨率场景深度保持独立；从相机与像素中心生成射线。'],
 ['裁剪区间','球域入口到出口，再由第一个不透明表面截断。'],
 ['积分 S / T','在全格或低格采样密度，输出未曝光 S.rgb 和 T。'],
 ['重建','Half 用四邻域插值；全格查询深度提供引导。'],
 ['HDR 合成','把全格 S/T 与引擎预曝光场景色合成。'],
] : [
 ['Create rays','Keep full-resolution depth independent; derive rays from the camera and pixel centres.'],
 ['Clip intervals','Sphere entry to exit, stopped by the first opaque surface.'],
 ['Integrate S / T','Sample density on the full or reduced grid; output unexposed S.rgb and T.'],
 ['Reconstruct','Half interpolates four neighbours, guided by full-grid query depth.'],
 ['Compose HDR','Combine full-grid S/T with pre-exposed engine scene colour.'],
];
const quickstart = `git clone --branch v0.1.0-preview.1 --depth 1 https://github.com/xiaoran6657/UEFogLab.git
cd UEFogLab
$EngineRoot = Read-Host 'UE 5.8.4 installation directory'
.\\tools\\Build.ps1 -EngineRoot $EngineRoot
.\\tools\\Test.ps1 -EngineRoot $EngineRoot
.\\tools\\Run.ps1 -EngineRoot $EngineRoot -Preset High`;
const pythonSetup = `python -m venv out/python
$FogPython = (Resolve-Path 'out/python/Scripts/python.exe').Path
& $FogPython -m pip install -r tools/requirements-desktop.txt`;
const numerical = `$CaptureRoot = Join-Path $PWD ('Saved/web-' + (Get-Date -Format 'yyyyMMdd-HHmmss-fff'))
.\\tools\\Readback.ps1 -EngineRoot $EngineRoot -Preset High -DebugLayer -Output (Join-Path $CaptureRoot 'prescribed')
& $FogPython tools/fog_analysis.py (Join-Path $CaptureRoot 'prescribed') --output (Join-Path $CaptureRoot 'prescribed-analysis.json')

.\\tools\\Readback.ps1 -EngineRoot $EngineRoot -LightingModel ManualDirectionalHG -Preset Medium -Width 640 -Height 360 -DebugLayer -Output (Join-Path $CaptureRoot 'manual')
& $FogPython tools/fog_m2_analysis.py (Join-Path $CaptureRoot 'manual') --output (Join-Path $CaptureRoot 'manual-analysis.json')`;
---
<Layout lang={lang} title={'UEFogLab · ' + uefoglab.subtitle[lang]} description={uefoglab.summary[lang]} path="projects/uefoglab/">
 <header class="wrap page-intro fog-intro">
  <p class="eyebrow">04 / UE 5.8 · LOCAL FOG</p><h1>UEFogLab</h1><p class="lede">{uefoglab.subtitle[lang]}</p>
  <p>{zh ? '一团局部雾会同时遮弱后方物体，并把散射光加入画面。这个项目先在 UE 中实现一条可检查的局部雾路径，再问：如果只在宽高各半的雾格上积分，能否利用场景深度重建边缘，换取更低的总成本？' : 'Local fog both attenuates the scene behind it and adds scattered light. This project builds an inspectable fog path in UE, then asks: can integration on a grid with half the width and height retain edges through depth guidance, at a lower total cost?'}</p>
  <div class="fog-takeaway"><strong>{zh ? '实测答案：积分更少，整体未必更快。' : 'Measured result: less integration does not guarantee a cheaper effect.'}</strong><p>{zh ? '已测手机夹具中，Half 的积分更便宜，新增重建却使 FogTotal 更高；细遮挡也可能完全漏采。因此 Full64 保持默认。下面解释原因、证据和动手复现路径。' : 'In the measured phone fixture, Half makes integration cheaper, but reconstruction raises FogTotal. Thin occluders can also be missed completely. Full64 stays the default. Below are the mechanism, evidence and reproduction route.'}</p></div>
  <div class="tag-row"><span>{uefoglab.status[lang]}</span><span>C++ / HLSL</span><span>Full64 / High</span></div>
  <div class="fog-links"><a id="source-repository" class="button button-outline" href={uefoglab.source.repository}>{zh ? '公开源码' : 'Public source'} ↗</a><a id="source-version" class="button button-outline" href={uefoglab.source.tag}>{uefoglab.source.version} ↗</a></div>
  <p class="fog-reading-note">{zh ? '阅读提示：窄屏表格、命令块和原图视窗可横向滚动；点击实验图可打开原尺寸。长参数与证据身份收在可展开详情中。' : 'Reading tip: scroll tables, command blocks and figure viewports horizontally on narrow screens; open experimental images for their original size. Expand the details for parameters and evidence identities.'}</p>
  <nav class="fog-nav" aria-label={zh ? '案例章节' : 'Case sections'}><a href="#approaches">{zh ? '方案选择' : 'Approaches'}</a><a href="#method">{zh ? '积分路径' : 'Integration'}</a><a href="#lighting">{zh ? '光照模型' : 'Lighting'}</a><a href="#quality">{zh ? '深度重建' : 'Reconstruction'}</a><a href="#native">{zh ? '原生对照' : 'Native comparison'}</a><a href="#mobile">{zh ? '真机成本' : 'Mobile cost'}</a><a href="#reproduce">{zh ? '动手复现' : 'Reproduce'}</a><a href="#limits">{zh ? '边界与来源' : 'Limits & sources'}</a></nav>
 </header>
  <section class="wrap fog-section" aria-labelledby="edit-title">
    <h2 id="edit-title">{zh ? '48 秒静帧展示剪辑' : 'A 48-second still-image showcase edit'}</h2>
    <p id="fog-video-note">{zh ? '六张静帧各 8 秒，无音轨。24fps 只是编码属性，不是实时录屏、GPU FPS 或运动稳定性证据。无需播放也可阅读下面的图表和结论。' : 'Six still slides, eight seconds each, no audio. 24fps is an encoding property, not measured FPS, real-time footage or motion evidence. The figures and results remain readable without playing the video.'}</p>
    <video controls preload="none" poster={media + 'cover.png'} width="1280" height="720" aria-describedby="fog-video-note"><source src={media + 'showcase.mp4'} type="video/mp4" /><a href={media + 'showcase.mp4'}>{zh ? '下载静帧剪辑' : 'Download the still-image edit'}</a></video>
    <p class="fog-caption">{zh ? '封面为 UE5.8.2 / RX9070 的实际 Manual HG Full64 静帧，加说明文字；历史显示素材保留原版本。开发、实验执行和独立审查由 coding agents 辅助，本人学习与技术掌握程度另行确认。' : 'The captioned cover derives from an actual UE5.8.2 / RX9070 Manual HG Full64 still. Historical display media keep their original identities. Coding agents assisted implementation, execution and independent review; owner study and technical mastery are tracked separately.'}</p>
  </section>
 <section class="wrap fog-section" id="approaches">
  <p class="eyebrow">01 / CHOOSING A REPRESENTATION</p><h2>{zh ? '先确定想解决哪类雾，再选择表示' : 'Choose a representation for the fog problem'}</h2>
  <p>{zh ? '大范围高度氛围、可摆放的局部雾团和受多灯照明的体积，需要不同表示。这里选择简单球域与屏幕射线，是为了把降采样的质量和成本拆开检查，而不是预设自研优于原生。' : 'Broad height atmosphere, local patches and volumes lit by many lights have different needs. A simple sphere and screen rays make downsampling quality and cost separable; superiority over native fog is not the premise.'}</p>
  <div class="table-wrap" tabindex="0" role="region" aria-label={zh ? '方案选择表，可横向滚动' : 'Approach comparison, horizontally scrollable'}><table><caption>{zh ? '表示、用途与实际覆盖' : 'Representation, use and actual coverage'}</caption><thead><tr><th scope="col">{zh ? '方案' : 'Approach'}</th><th scope="col">{zh ? '表示与适用问题' : 'Representation and use'}</th><th scope="col">{zh ? '本项目覆盖' : 'Coverage here'}</th></tr></thead><tbody>{approaches.map(row=><tr>{row.map((cell,i)=>i===0?<th scope="row">{cell}</th>:<td>{cell}</td>)}</tr>)}</tbody></table></div>
  <p class="fog-caption">{zh ? '原生能力依据 Epic 文档，本机实验另见原生对照节：' : 'Native capabilities follow Epic documentation; local experiments have a narrower scope below: '}<a href="https://dev.epicgames.com/documentation/en-us/unreal-engine/exponential-height-fog-in-unreal-engine">Height Fog</a> · <a href="https://dev.epicgames.com/documentation/en-us/unreal-engine/local-fog-volumes-in-unreal-engine">Local Fog Volumes</a> · <a href="https://dev.epicgames.com/documentation/en-us/unreal-engine/volumetric-fog-in-unreal-engine">Volumetric Fog</a></p>
 </section>
 <section class="wrap fog-section" id="method">
  <p class="eyebrow">02 / RAY → S/T → HDR</p><h2>{zh ? '每条射线回答：加了多少光，留下多少背景？' : 'Each ray asks: what light is added, and what background survives?'}</h2>
  <p>{zh ? '场景先提供不透明深度和线性 HDR 颜色。雾保存四通道结果：S.rgb 是沿视线累积到相机的散射贡献，T 是背景穿过介质后的透射率。先重建这两个量，再与场景合成，比直接放大最终屏幕 RGB 更容易分清介质与背景。' : 'The scene supplies opaque depth and linear HDR colour. Fog stores four channels: S.rgb is scattering accumulated toward the camera; T is background transmittance through the medium. Reconstructing these quantities before composition keeps medium and background separate.'}</p>
  <figure class="fog-diagram"><ol class="fog-pipeline">{pipeline.map((row,i)=><li><span class="step-number">0{i+1}</span><h3>{row[0]}</h3><p>{row[1]}</p></li>)}</ol><figcaption>{zh ? '流程示意，非实验画面。场景尺寸独立于雾工作格；Half 的宽高各为1/2，雾像素数量为1/4，最终场景尺寸不变。' : 'Pipeline schematic, not an experimental image. Scene extent is independent of the fog grid. Half has 1/2 the width and height, or 1/4 as many fog pixels; final scene extent stays unchanged.'}</figcaption></figure>
  <h3>{zh ? '先找到应该积分的介质区间' : 'Find the visible medium interval'}</h3>
  <p>{zh ? '归一化相机射线与球求交，入口从相机前方开始，出口与不透明深度取较近者。物体后方的雾不应继续贡献；无交点或区间为空时输出 S=0、T=1。DeviceZ 必须按引擎投影转换，不能直接当线性距离。' : 'Intersect a normalized camera ray with the sphere, clamp entry to the space in front of the camera, and stop at the nearer of sphere exit and opaque depth. Fog behind an opaque surface must not contribute. A miss or empty interval yields S=0,T=1. Convert DeviceZ through the engine projection rather than treating it as linear distance.'}</p>
  <details><summary>{zh ? '像素中心、深度点与射线：三套坐标怎样对应？' : 'How pixel centres, depth samples and rays correspond'}</summary><p>{zh ? '低格像素 i 的名义 UV 为(i+0.5)/F；其深度从全格 canonical 整数点 min(V−1,floor((2i+1)V/(2F))) 读取，再加 ViewMin，逐轴计算。V 是视图尺寸，F 是雾尺寸。低格射线仍用名义 UV，不能混成 canonical 深度像素自己的射线；重建又从全格查询点映回低格四邻域。修复整数选择消除了特定索引漂移，不代表一般几何近似全部无误差。' : 'Low-grid pixel i uses nominal UV(i+0.5)/F. Depth is read at full-grid canonical integer min(V−1,floor((2i+1)V/(2F))) plus ViewMin, per axis. V is view size and F fog size. The ray still uses nominal UV, not the canonical depth pixel’s ray. Reconstruction maps full-grid queries back to four low-grid neighbours. Fixed integer selection removes a specific indexing drift, not every geometric approximation.'}</p><p><a href={desktopShader}>{zh ? '固定 tag：桌面射线与深度选择' : 'Pinned desktop ray and depth selection'}</a> · <a href={mobileShader}>{zh ? '移动轴向深度与名义射线' : 'Mobile axial depth and nominal ray'}</a></p></details>
  <h3>{zh ? '距离、密度和消光，怎样形成 S/T？' : 'How do distance, density and extinction produce S/T?'}</h3>
  <dl class="fog-glossary">
   <div><dt>ρ</dt><dd>{zh ? '无量纲相对密度。桌面夹具有均匀、四次径向和确定性正弦调制；移动已有证据仅均匀密度。' : 'Dimensionless relative density. Desktop fixtures include uniform, quartic radial and deterministic sine modulation; mobile evidence uses uniform density only.'}</dd></div>
   <div><dt>σt · Δs</dt><dd>{zh ? 'σt 是基准消光系数(m⁻¹)，Δs 是分段长度。几何存储为 cm，必须先用 Δs_m=0.01×Δs_cm 转为 m。' : 'σt is base extinction(m⁻¹); Δs is segment length. Geometry uses cm, so convert using Δs_m=0.01×Δs_cm.'}</dd></div>
   <div><dt>τ · T</dt><dd>{zh ? 'τ 是无量纲光学厚度，T=exp(−τ)。T=1让背景完全通过，T=0完全遮弱背景。' : 'τ is dimensionless optical depth; T=exp(−τ). T=1 passes the background unchanged; T=0 fully attenuates it.'}</dd></div>
   <div><dt>J · S</dt><dd>{zh ? 'J 是源函数，表示单位消光对应的散射颜色输入，不是沿距离直接相加的亮度。S 包含该段消光和前段透射权重，尚未预曝光。' : 'J is the source function: scattering colour per unit extinction, not brightness simply added per unit distance. S includes segment extinction and front-segment transmittance, before pre-exposure.'}</dd></div>
   <div><dt>P</dt><dd>{zh ? 'P=View.PreExposure。Cin 已被引擎预曝光，只把相同的 P 乘到未曝光 S 上；无量纲 T 不乘曝光。' : 'P=View.PreExposure. Cin is already pre-exposed, so only unexposed S receives the same P. Dimensionless T is not exposure-scaled.'}</dd></div>
  </dl>
  <div class="fog-equations" aria-label={zh ? '光学积分与合成公式' : 'Optical integration and composition equations'}><code>τ = Σ σt · ρᵢ · Δsᵢ,m</code><code>T = exp(−τ)</code><code>S₀ = 0, T₀ = 1</code><code>αᵢ = 1 − exp(−τᵢ)</code><code>Sᵢ₊₁ = Sᵢ + Tᵢ · Jᵢ · αᵢ</code><code>Tᵢ₊₁ = Tᵢ · exp(−τᵢ)</code><code>Cout = P · S + T · Cin</code></div>
  <p>{zh ? '每段用中点密度估计 τᵢ，再做常源函数的解析分段更新。前段 Tᵢ 遮弱远处加入的光；消光越强，背景透射越小。若整条射线 J 恒定，S=J·(1−T)。该恒等式可作独立数学核对，但本身不能证明方向光或深度正确。' : 'Midpoint density estimates each τᵢ, followed by a constant-source segment update. Earlier Tᵢ attenuates farther contributions. With ray-constant J, S=J·(1−T). This identity supports an independent math check but cannot by itself validate lighting directions or depth.'}</p>
  <p class="fog-caption">{zh ? '透射理论与固定实现：' : 'Transmittance theory and pinned implementation: '}<a href="https://pbr-book.org/4ed/Volume_Scattering/Transmittance">PBRT</a> · <a href={desktopShader}>IntegrateCS / CompositePS</a></p>
 </section>
 <section class="wrap fog-section" id="lighting">
  <p class="eyebrow">03 / WHAT LIGHTING IS ACTUALLY SOLVED</p><h2>{zh ? '先用固定 J 验证光学，再加入手动方向光' : 'Validate optics with fixed J, then add a manual directional light'}</h2>
  <div class="fog-models"><article><h3>Prescribed</h3><p>{zh ? '固定 J=(0.35,0.60,0.90)，把密度、消光、步数和深度误差从复杂照明中分离。这是给定源函数的验证夹具，不是由 UE 场景灯光求解散射。' : 'J=(0.35,0.60,0.90) is prescribed. This separates density, extinction, step count and depth errors from complex lighting. It is a given-source validation fixture, not scattering derived from UE lights.'}</p></article><article><h3>ManualDirectionalHG</h3><p>{zh ? '输入光子传播方向 k、RGB 相对权重 E、albedo 和 HG 参数 g：J_ray=albedo×E×pHG(k·v)。k 从光源指向采样点，v 从采样点指向相机。E 不是 UE lux；平行光与单位入射透射／可见性使 J 沿每条直射线恒定。' : 'Inputs are photon direction k, relative RGB weight E, albedo and HG parameter g: J_ray=albedo×E×pHG(k·v). k points from light toward sample; v points toward camera. E is not UE lux. Parallel light with unit incoming transmittance/visibility makes J constant on each straight ray.'}</p></article></div>
  <details><summary>{zh ? 'HG 方向约定与数值实现' : 'HG conventions and numerical implementation'}</summary><div class="fog-equations"><code>μ = dot(k,v), v = −rayDirection</code><code>pHG(μ) = (1−g²) / [4π(1+g²−2gμ)^(3/2)]</code></div><p>{zh ? 'g=0各向同性，正 g 偏向光子原传播方向。方向须按本实现读取，不能混用 PBRT 双向外向约定。Manual 对中点密度做补偿 τ 累加，再闭式求 S/T，并显式选择 half 最近偶数舍入；Prescribed 用逐段递推和小 τ 稳定近似。数学关系相同，具体数值操作不同。' : 'g=0 is isotropic; positive g favours photon propagation. Follow this convention rather than mixing it with PBRT’s two-outward-direction convention. Manual uses compensated τ accumulation, closed S/T and explicit half round-to-nearest-even. Prescribed uses segment recurrence and a small-τ approximation. The math agrees while numerical operations differ.'}</p><p><a href="https://pbr-book.org/4ed/Volume_Scattering/Phase_Functions">PBRT: phase functions</a> · <a href={desktopShader}>{zh ? '本实现方向与积分' : 'Implementation conventions and integration'}</a></p></details>
  <p>{zh ? '两条自研模型都没有 UE 自动取光、入射路径衰减、体积阴影、多次散射、透明整合或自研时域。移动实测仅 Uniform Prescribed；桌面 Manual 彩色图不能当作移动照明验证。' : 'Neither custom model includes UE light extraction, incoming attenuation, volume shadows, multiple scattering, transparent integration or custom temporal reconstruction. Phone evidence is Uniform Prescribed only; desktop Manual stills do not validate mobile lighting.'}</p>
 </section>
 <section class="wrap fog-section" id="quality">
  <p class="eyebrow">04 / FOUR-NEIGHBOUR RECONSTRUCTION</p><h2>{zh ? '深度选择相容的雾样本，不能创造缺失样本' : 'Depth selects compatible fog samples; it cannot create missing ones'}</h2>
  <p>{zh ? 'Half 减少积分射线后，每个全格像素仍需 S/T。双线性只按空间距离混合四个邻居，可能把前景短积分与背景长积分混在一起，产生光晕或漏雾。深度引导为同样四个空间权重再乘深度相容权重，减少跨表面混合。' : 'After Half reduces integration rays, every full-grid pixel still needs S/T. Bilinear interpolation mixes four neighbours by spatial distance, potentially blending short foreground and long background intervals into halos or leakage. Depth guidance multiplies those same spatial weights by depth compatibility to reduce cross-surface mixing.'}</p>
  <figure class="fog-sampling"><svg viewBox="0 0 340 230" role="img" aria-labelledby="taps-title taps-desc"><title id="taps-title">{zh ? '四邻域深度引导示意' : 'Four-neighbour depth guidance'}</title><desc id="taps-desc">{zh ? 'A和C与查询同处近深度侧，远侧B和D权重压低。颜色与位置仅示意，没有实验值。' : 'A and C are on the query’s near-depth side; far-depth B and D receive lower weights. Colours and positions are illustrative, not measurements.'}</desc><rect x="16" y="18" width="308" height="194" rx="10" fill="var(--surface)" stroke="var(--line)"/><path d="M194 18V212" stroke="var(--muted)" stroke-dasharray="5 5"/><path d="M85 65L150 125L85 175" fill="none" stroke="var(--text)" stroke-width="3"/><path d="M255 65L150 125L255 175" fill="none" stroke="var(--muted)" stroke-dasharray="4 5"/><g fill="var(--text)"><circle cx="85" cy="65" r="12"/><circle cx="85" cy="175" r="12"/></g><g fill="var(--muted)"><circle cx="255" cy="65" r="12"/><circle cx="255" cy="175" r="12"/></g><circle cx="150" cy="125" r="11" fill="var(--accent)" stroke="var(--text)" stroke-width="2"/><g fill="var(--text)" font-size="16" font-family="sans-serif"><text x="68" y="42">A</text><text x="250" y="42">B</text><text x="68" y="204">C</text><text x="250" y="204">D</text><text x="112" y="110">{zh ? '查询' : 'query'}</text></g></svg><figcaption><strong>{zh ? '示意：空间近，不一定深度近。' : 'Schematic: image proximity is not depth proximity.'}</strong> {zh ? '将整个(S.r,S.g,S.b,T)向量共同加权归一化，得到查询点 S/T，最后做 P·S+T·Cin。直接模糊已合成 RGB 会把背景颜色卷入重建。' : 'Weight and normalize each whole (S.r,S.g,S.b,T) vector, then apply P·S+T·Cin. Blurring composed RGB would also mix background colours into reconstruction.'}</figcaption></figure>
  <div class="fog-equations"><code>wᵢ = w_spatial,ᵢ · w_depth,ᵢ</code><code>(S,T)_query = Σwᵢ·(S,T)ᵢ / Σwᵢ</code></div>
  <h3>{zh ? '共同思路，桌面与移动两套具体策略' : 'One idea, two different desktop/mobile policies'}</h3>
  <div class="table-wrap" tabindex="0" role="region" aria-label={zh ? '桌面移动重建规则，可横向滚动' : 'Desktop/mobile reconstruction rules, horizontally scrollable'}><table><thead><tr><th scope="col">{zh ? '路径' : 'Path'}</th><th scope="col">{zh ? '深度权重（cm）' : 'Depth weight (cm)'}</th><th scope="col">{zh ? '权重和 ≤ 10⁻⁶ 时' : 'When weight sum ≤ 10⁻⁶'}</th></tr></thead><tbody><tr><th scope="row">{zh ? '桌面：射线距离 D' : 'Desktop: ray distance D'}</th><td><code>exp(−abs(Dᵢ−Dq)/max(2,0.01·Dq))</code><p>{zh ? '尺度随查询距离改变，没有25cm硬门限。' : 'Scale follows query distance, without a 25cm hard cutoff.'}</p></td><td>{zh ? '取深度差最小邻居的已有 S/T。' : 'Use existing S/T from the neighbour with the smallest depth difference.'}</td></tr><tr><th scope="row">{zh ? '移动：轴向深度 Z' : 'Mobile: axial depth Z'}</th><td><code>Δ = abs(Zᵢ−Zq)</code><p>{zh ? '天空0只与天空相容；其余 Δ≤25时 exp(−Δ/10)，否则0；guide以R32保存。' : 'Sky 0 only matches sky. Otherwise use exp(−Δ/10) for Δ≤25, or 0 beyond it. The guide uses R32 storage.'}</p></td><td>{zh ? '取空间双线性权重最大的邻居，不是深度最近者。' : 'Use the largest spatial bilinear weight, not the nearest depth.'}</td></tr></tbody></table></div>
  <p class="fog-caption"><a href={desktopShader}>ReconstructFog</a> · <a href={mobileShader}>RangeWeight / ReconstructSTCS</a> · {zh ? '思想参考：' : 'Conceptual references: '}<a href="https://johanneskopf.de/publications/jbu/">Joint Bilateral Upsampling</a> / <a href="https://developer.nvidia.com/gpugems/gpugems3/part-iv-image-effects/chapter-23-high-speed-screen-particles">GPU Gems3 Ch.23</a>{zh ? '；不是完整论文复现。' : '; this is not a full reproduction of either work.'}</p>
  <h3 id="quality-figure-title">{zh ? '看图：立柱轮廓、细杆，再到雾团边界' : 'Read the figure: pillar silhouettes, thin rods, then the fog boundary'}</h3>
  <p>{zh ? '三幅图显示 T，不是最终颜色。白色T=1表示背景通过，暗色表示透射降低。比较同一位置，Bilinear过渡容易跨表面；Guided保留许多边缘，但不是每一点都更接近Full。' : 'These panels show T, not final colour. White T=1 passes the background; darker values mean lower transmission. Compare identical positions: bilinear transitions readily cross surfaces; guidance retains many edges without guaranteeing improvement at every point.'}</p>
  <figure><div class="figure-pan" tabindex="0" role="region" aria-labelledby="quality-figure-title"><a href={media+'reconstruction-triptych.png'}><img src={media+'reconstruction-triptych.png'} width="1280" height="500" loading="lazy" alt={zh ? '同一T显示范围下Full64、Half64双线性和引导并排图' : 'Full64, Half64 bilinear and guided T on the same fixed scale'} /></a></div><figcaption>{zh ? '相同步数、场景与源函数，只有雾格／重建变化。引导收益来自选择样本，不是提高积分步数。窄屏可横向滚动图窗或点击原图。' : 'Step count, scene and source are shared; only fog grid/reconstruction change. Guidance selects samples rather than increasing integration steps. Scroll the figure on narrow screens or open the original.'}</figcaption></figure>
  <details><summary>{zh ? '桌面条件、同模型参考与局部反例' : 'Desktop conditions, references and local regressions'}</summary><p>{zh ? '历史图：UE5.8.2／RX9070／D3D12 SM6，Prescribed/radial，scene640×360，full640×360／half320×180，64步；修复源 ' : 'Historical figures: UE5.8.2 / RX9070 / D3D12 SM6, Prescribed/radial, scene640×360, full640×360/half320×180,64 steps; repair source '}<code>{r.desktop.prescribed.sourceRevision}</code>。</p><p>{zh ? '高采样 Reference 只在记录过收敛的同模型夹具内作受限数值参考；名称不保证真值。这里 High/Full64 是同档显示基线，不是 Reference。S/T 浮点误差、线性 HDR 误差和色调映射 RGB 码差不能混为同一指标。' : 'High-sample Reference is a bounded numerical reference only where same-model convergence was recorded. High/Full64 here is a same-tier display baseline, not Reference. S/T float error, linear HDR error and tonemapped RGB-code differences are distinct metrics.'}</p><figure><a href={media+'desktop-st.png'}><img src={media+'desktop-st.png'} width="1920" height="2304" loading="lazy" alt={zh ? '修复后的Prescribed原始S/T和固定误差图' : 'Repaired Prescribed S/T and fixed-scale error sheet'} /></a></figure><p><a href={media+'desktop-counterexample.png'}>{zh ? '同模型局部反例原图' : 'Original same-model local counterexample'}</a></p><figure><a href={media+'native-edge.png'}><img src={media+'native-edge.png'} width="2080" height="1260" loading="lazy" alt={zh ? 'Manual固定边缘ROI及引导局部退化' : 'Fixed Manual edge ROI retaining a guided regression'} /></a><figcaption>{zh ? 'Manual显示反例为1280×720／half640×360／64步。采后说明点(799,411)相对High的最大RGB码差B=0、G=2，表明逐像素改善不成立，不能改写为S/T精度排名。' : 'Manual display example:1280×720/half640×360/64 steps. At post-capture illustrative point(799,411), maximum RGB-code difference from High is B=0,G=2. This disproves every-pixel improvement, not an S/T accuracy ranking.'}</figcaption></figure></details>
 </section>
 <section class="wrap fog-section" id="native">
  <p class="eyebrow">05 / SAME SCENE, DIFFERENT MODELS</p><h2>{zh ? '原生对照回答“画面和能力有什么差异”' : 'Native comparisons show visual and feature differences'}</h2>
  <p>{zh ? '先用 Off 确认无雾时的立柱／背景，再看自研 Manual 的亮度、轮廓和降采样变化，最后看独立LFV与LFV→VF。共同几何、相机、手动曝光与输出处理使画面可并排阅读，但密度、光照单位、网格和历史不同，不能逐像素排准确率，也没有在此组图上计时。' : 'Start with Off to see the pillars/background without fog, then inspect custom Manual brightness, silhouettes and downsampling before standalone LFV and LFV→VF. Shared geometry, camera, manual exposure and processing support side-by-side reading. Density, light units, grids and history differ: these are neither pixel-accuracy rankings nor timing samples.'}</p>
  <h3 id="native-figure-title">{zh ? '八种固定配置：边缘、密度形状与历史开关' : 'Eight fixed configurations: edges, density shape and history'}</h3>
  <figure><div class="figure-pan" tabindex="0" role="region" aria-labelledby="native-figure-title"><a href={media+'native-comparison.png'}><img src={media+'native-comparison.png'} width="2640" height="1050" loading="lazy" alt={zh ? 'Off、自研全半格、独立LFV、LFV注入VF且历史开关的八格图' : 'Eight panels of Off, full/half custom fog, standalone LFV and LFV→VF with history on/off'} /></a></div><figcaption>{zh ? '上排比较自研 Full／HalfB／HalfG 轮廓，下排区分独立LFV与体素化VF。观察雾团外缘、柱体对比和细杆周围；整体更亮不等于物理更准确。' : 'Compare custom Full/HalfB/HalfG silhouettes above, then standalone LFV and voxelized VF below. Inspect the fog boundary, pillar contrast and thin rods; higher brightness is not evidence of greater physical accuracy.'}</figcaption></figure>
  <div class="table-wrap" tabindex="0" role="region" aria-label={zh ? '原生模型差异，可横向滚动' : 'Native model differences, horizontally scrollable'}><table><thead><tr><th scope="col">{zh ? '模式' : 'Mode'}</th><th scope="col">{zh ? '这组画面中的含义' : 'Meaning here'}</th><th scope="col">{zh ? '必须保留的差异' : 'Differences that matter'}</th></tr></thead><tbody><tr><th scope="row">Off</th><td>{zh ? '共同场景校准，自研／局部原生雾关闭。' : 'Scene calibration with custom/local native fog off.'}</td><td>{zh ? '不代表零整帧成本。' : 'Not zero whole-frame cost.'}</td></tr><tr><th scope="row">Ours Manual HG</th><td>{zh ? '四次径向消光，手动相对E，全半格及64／32步。' : 'Quartic radial extinction, relative manual E; full/half grids and 64/32 steps.'}</td><td>{zh ? '无UE取光、体积阴影或历史。' : 'No UE light extraction, volume shadows or history.'}</td></tr><tr><th scope="row">LFV standalone</th><td>{zh ? '独立解析局部体，原生径向／高度分布。' : 'Standalone analytic local volume with native radial/height distribution.'}</td><td>{zh ? '密度／照明单位不同；height=8是覆盖门，不是共同物理密度。' : 'Density/light units differ; height=8 is a coverage gate, not matched physical density.'}</td></tr><tr><th scope="row">LFV → VF</th><td>{zh ? 'LFV密度注入VF网格，分别开关时间历史。' : 'LFV density injected into VF, with history on/off.'}</td><td>{zh ? '160×90×128网格、不同密度／灯光路径；静态接近不能证明运动稳定。' : 'A 160×90×128 grid, different density/lighting; static similarity does not establish motion stability.'}</td></tr></tbody></table></div>
  <p>{zh ? '共同场景无阴影；Epic VF 的体积灯光／阴影能力不等于这组图已经验证。独立LFV仍使用方向光、天空光的快速解析光照近似，没有VF那套空间体积光照与阴影；它与LFV注入VF也是不同路径。自研模式关闭重复原生雾，避免两份雾叠加后误当算法效果。' : 'The common scene is unshadowed; Epic VF lighting/shadow capabilities are not validated by these stills. Standalone LFV still uses fast analytic approximations for directional light and skylight. It does not use the spatial volume lighting and shadows of VF; injecting LFV into VF takes a distinct path. Custom mode disables duplicate native fog to avoid mistaking their combined effect for a custom result.'}</p>
  <details><summary>{zh ? '历史版本、参数和比较来源' : 'Historical version, parameters and source'}</summary><p>UE5.8.2 / RX9070 / D3D12 SM6 · scene1280×720 · full1280×720 / half640×360 · 64 steps（Low32）· Manual albedo=0.8, g=0.5, E=(4,3,2), normalized k=(−1,−1,0.15) · capture <code>{r.desktop.nativeDisplay.captureRevision}</code>。</p><p>{zh ? 'VF历史权重CVar为0.9，TR off保留同一jitter／距离。120／180帧静态观察只记录显示RGB p99=1、max=3，不代表S/T收敛或运动稳定。面板统一缩放，无逐图曝光／色阶调整。内部历史提交只作身份，不编造成公开可访问提交。' : 'VF history-weight CVar is 0.9; TR off retains the same jitter/distance. The 120/180-frame static observation records display RGB p99=1,max=3, not S/T convergence or motion stability. Panels share resizing without per-image grading. Internal historical revisions are identifiers, not fabricated reachable public commits.'}</p><p><a href={source+'docs/showcase/evidence/summary.md'}>{zh ? '固定公开证据摘要' : 'Pinned public evidence summary'}</a> · <a href={source+'tools/m3_config.json'}>{zh ? '原生配置' : 'Native configuration'}</a></p></details>
 </section>
 <section class="wrap fog-section" id="mobile">
  <p class="eyebrow">06 / MOBILE QUALITY &amp; COST</p><h2>{zh ? '真机结果：省下的积分，被重建开销超过了' : 'On the phone, reconstruction costs more than integration saves'}</h2>
  <p>{zh ? '移动移植单独检查真实路径：保留native depth，以R32 guide和S/T缓冲重建，再由像素着色器把HDR交回引擎。本节解释已记录真机实验，不从桌面SM5或Mobile Preview推断Android支持。' : 'The port separately checks the real mobile path: retained native depth, an R32 guide and S/T buffers, then pixel-shader HDR return to the engine. This explains recorded device experiments rather than inferring Android support from desktop SM5 or Mobile Preview.'}</p>
  <dl class="fog-conditions"><div><dt>{zh ? '设备／引擎' : 'Device / engine'}</dt><dd>{r.mobile.hardware} · UE{r.mobile.engine}</dd></div><div><dt>{zh ? '渲染路径' : 'Rendering path'}</dt><dd>{r.mobile.renderer} · ViewMin=({r.mobile.viewMin.join(',')})</dd></div><div><dt>{zh ? '场景／雾格' : 'Scene / fog grid'}</dt><dd>{r.mobile.scene.join('×')} · Full={r.mobile.scene.join('×')} · Half={r.mobile.halfFog.join('×')}</dd></div><div><dt>{zh ? '模型／采样' : 'Model / sampling'}</dt><dd>{r.mobile.model} · {r.mobile.steps}{zh ? '步' : ' steps'} · σt={r.mobile.extinctionPerMetre}m⁻¹ · P={r.mobile.preExposure}</dd></div><div><dt>{zh ? '计时构建／夹具' : 'Timing build / fixture'}</dt><dd>{r.mobile.timing.build} · {r.mobile.timing.fixture}</dd></div></dl>
  <h3>{zh ? '先看每个 pass 做了什么' : 'First, identify the work in each pass'}</h3>
  <ul class="fog-pass-list"><li><strong>IntegrateWithGuide</strong> — {zh ? '沿射线积64段并写S/T和guide；Half射线更少，当前Full也包含R32 guide成本。' : 'Integrates 64 segments and writes S/T plus a guide. Half has fewer rays; the current Full path also pays for an R32 guide.'}</li><li><strong>ReconstructST</strong> — {zh ? '每个全格像素读取四邻域，HalfG还读guide、算相容权重；Full已有对应S/T，不需要此pass。' : 'Fetches four neighbours per full-grid pixel. HalfG also reads the guide and evaluates compatibility; Full already has matching S/T and needs no reconstruction pass.'}</li><li><strong>CompositeHDR</strong> — {zh ? '读取全场景S/T与Cin，执行P·S+T·Cin；场景尺寸没有随Half变小。' : 'Reads full-scene S/T and Cin, evaluating P·S+T·Cin. Half does not shrink the scene extent.'}</li></ul>
  <div class="table-wrap" tabindex="0" role="region" aria-label={zh ? 'GPU分项成本，可横向滚动' : 'GPU component costs, horizontally scrollable'}><table class="fog-cost-table"><caption>{zh ? '固定Development／Planes：四trial p50的中位数，单位ms' : 'Fixed Development / Planes: median of four trial p50s, in ms'}</caption><thead><tr><th scope="col">{zh ? '模式' : 'Mode'}</th><th scope="col">IntegrateWithGuide</th><th scope="col">ReconstructST</th><th scope="col">CompositeHDR</th><th scope="col">FogTotal</th></tr></thead><tbody>{modes.map(row=><tr><th scope="row">{row.name}</th><td>{row.IntegrateWithGuide.medianOfTrialMediansMs.toFixed(3)}</td><td>{row.ReconstructST.medianOfTrialMediansMs.toFixed(3)}</td><td>{row.CompositeHDR.medianOfTrialMediansMs.toFixed(3)}</td><td><strong>{row.FogTotal.medianOfTrialMediansMs.toFixed(3)}</strong></td></tr>)}</tbody></table></div>
  <p>{zh ? '从左往右读：Half积分下降，合成仍覆盖全格；新增重建超过积分节省，引导还有额外成本。因此这里没有半分辨率提速结论。数据说明pass组合的实际代价，尚未证明频率、带宽或某个硬件单元就是瓶颈。' : 'Read left to right: Half lowers integration, while composition still covers the full grid. Added reconstruction exceeds the saving, with guidance costing more again. These pass costs do not support a half-resolution speedup here, nor establish an unmeasured frequency, bandwidth or hardware-unit bottleneck.'}</p>
  <details><summary>{zh ? '完整精度、重复采样与统计边界' : 'Full precision, repetitions and statistical limits'}</summary><div class="table-wrap" tabindex="0"><table><thead><tr><th scope="col">{zh ? '模式' : 'Mode'}</th><th scope="col">FogTotal ms</th><th scope="col">{zh ? '四trial中位数范围' : 'Range of four medians'}</th><th scope="col">{zh ? '独立block p50' : 'Independent-block p50'}</th></tr></thead><tbody>{modes.map(row=><tr><th scope="row">{row.name}</th><td>{row.FogTotal.medianOfTrialMediansMs.toFixed(6)}</td><td>{row.FogTotal.rangeOfTrialMediansMs.map(x=>x.toFixed(6)).join('–')}</td><td>{row.freshFogTotalMs.toFixed(6)}</td></tr>)}</tbody></table></div><p>{zh ? '作者四个平衡区组共16trial／7708帧（含Off）；独立完整区组4trial／1925帧。先取每trial的p50，再取四值中位数；min–max不是置信区间。子scope中位数不必精确相加成总中位数。BOP FogTotal包括marker／barrier和当前Full R32 guide，插桩也扰动调度。Off零值是雾scope关闭，不是整帧为零。' : 'Four balanced author blocks contain 16 trials / 7708 frames including Off; an independent complete block contains 4 trials / 1925 frames. Each trial contributes a p50, then four values form the median; min–max is not a confidence interval. Component medians need not add to the total median. BOP FogTotal includes markers/barriers and Full R32 guide; instrumentation perturbs scheduling. Off’s zero disables the fog scope, not the whole frame.'}</p><p>{zh ? 'whole GPU frame、FPS和能耗不可用，不能把FogTotal倒数当整帧FPS。频率不可读，电池温度仅代理，不证明恒频。计时native ' : 'Whole GPU frame, FPS and energy are unavailable; inverting FogTotal does not yield whole-frame FPS. Frequency is unreadable and battery temperature is only a proxy. Timing native '}<code>{r.mobile.timing.nativeSourceRevision}</code> / host <code>{r.mobile.timing.hostSourceRevision}</code>。</p></details>
  <h3 id="cost-quality-title">{zh ? '看图：左是成本，右是独立质量包的失败案例' : 'Read the plot: cost on the left, a separate-quality-APK failure on the right'}</h3>
  <figure><div class="figure-pan" tabindex="0" role="region" aria-labelledby="cost-quality-title"><a href={media+'mobile-cost-quality.png'}><img src={media+'mobile-cost-quality.png'} width="1280" height="620" loading="lazy" alt={zh ? 'Full和Half的总成本及ThinStripe约0.428的T误差' : 'Full/Half total costs and approximately 0.428 T error in ThinStripe'} /></a></div><figcaption>{zh ? '左侧橙叉为独立完整区组；右侧两柱表明更聪明的权重也可能无法恢复漏采遮挡。质量和计时来自不同APK，不能称为计时包新测质量矩阵。' : 'Orange crosses show the independent complete block. The right bars show that smarter weights can still fail to recover a missed occluder. Quality and timing use separate APKs, not a fresh quality matrix on the timing package.'}</figcaption></figure>
  <h3>{zh ? '为何细条会同时击败 Bilinear 和 Guided？' : 'Why can a thin stripe defeat both bilinear and guidance?'}</h3>
  <p>{zh ? 'ThinStripe中，全格深度有120个像素命中细遮挡，低格canonical深度点却一个也没命中。已有低格积分因此没有在细条表面截断，终点落在其后。全格查询虽看见近处细条，四个邻居却都只有远处S/T；移动相容权重全为零，只能fallback。重加权已有结果不能凭空补出在缺失表面截断的积分。' : 'In ThinStripe, 120 full-grid depth pixels hit the thin occluder, but no low-grid canonical depth sample does. Existing low-grid integrals are not clipped at the stripe: they end farther behind it. The full-grid query sees the near stripe, yet all four neighbours contain farther-interval S/T. Mobile compatibility weights become zero, forcing fallback. Reweighting cannot invent an integral clipped at the missing surface.'}</p>
  <h3 id="thin-figure-title">{zh ? '读反例：深度 → Full T → 零相容与fallback' : 'Read the failure: depth → Full T → zero compatibility and fallback'}</h3>
  <figure><div class="figure-pan" tabindex="0" role="region" aria-labelledby="thin-figure-title"><a href={media+'mobile-thin-roi.png'}><img src={media+'mobile-thin-roi.png'} width="1800" height="1200" loading="lazy" alt={zh ? 'ThinStripe六格实际GPU诊断：guide、Full T、相容数、误差与fallback' : 'Six actual ThinStripe diagnostics: guide, Full T, compatible taps, errors and fallback'} /></a></div><figcaption>{zh ? '沿竖直细条看：查询深度和Full T识别遮挡，相容邻居却为0；下排B/G误差仍高且有fallback。固定thin-hit ROI=[1000,300,1001,420)，两法T MAE均约0.428。全图预算通过不表示细物体恢复，Full保留默认。' : 'Follow the stripe: query depth and Full T identify the occluder, but compatible tap count is 0. B/G errors remain high with fallback. In fixed thin-hit ROI[1000,300,1001,420), both have T MAE around 0.428. Passing whole-image budgets does not establish thin-object recovery; Full remains the default.'}</figcaption></figure>
  <details><summary>{zh ? 'Planes改善多少？质量数值和指标含义' : 'How much does Planes improve? Values and metric definitions'}</summary><p>{zh ? 'MAE是平均绝对误差；RMSE先平方平均再开方，对较大误差更敏感。T无量纲、范围0–1；HDR蓝通道是线性颜色，不是截图8位蓝色。参照是actual Full64同模型同档结果，不表示Full物理误差为零。' : 'MAE is mean absolute error; RMSE squares errors before averaging and taking the square root, emphasizing larger errors. T is dimensionless in 0–1. HDR blue is linear colour, not an 8-bit screenshot channel. Actual same-model, same-tier Full64 is the reference, not zero physical error.'}</p><div class="table-wrap" tabindex="0"><table><thead><tr><th scope="col">{zh ? '相对actual Full64' : 'Versus actual Full64'}</th><th scope="col">HalfB64</th><th scope="col">HalfG64</th></tr></thead><tbody>{quality.map(item=><tr><th scope="row">{item[lang]}</th><td>{r.mobile.quality.rows.HalfB64[item.key].toFixed(9)}</td><td>{r.mobile.quality.rows.HalfG64[item.key].toFixed(9)}</td></tr>)}</tbody></table></div><p>{zh ? '上述Planes中Guided更低，ThinStripe仍失败，不能概括为逐像素改善。质量源 ' : 'Guided is lower on these Planes metrics, while ThinStripe still fails. Quality source '}<code>{r.mobile.quality.sourceRevision}</code>；{zh ? '历史11项矩阵／6个actual-Full对照限定接纳，计时APK另算。Odd775×359仅雾工作格，不是奇数场景。' : 'the bounded historical scope contains 11 matrix cases / 6 actual-Full pairs and remains separate from the timing APK. Odd775×359 is a fog grid, not an odd scene.'}</p><p><a href={media+'mobile-planes-roi.png'}>{zh ? 'Planes冻结ROI原图' : 'Frozen Planes ROI figure'}</a> · <a href={media+'results.json'}>{zh ? '精简数值、ROI和APK身份' : 'Compact values, ROIs and APK identities'}</a></p></details>
 </section>
 <section class="wrap fog-section" id="reproduce">
  <p class="eyebrow">07 / REPRODUCE THE PUBLIC TAG</p><h2>{zh ? '从公开源码开始，先看到场景，再检查数值' : 'Start from public source: view the scene, then check the numbers'}</h2>
  <p>{zh ? '桌面最短路径：Windows、PowerShell 7、安装版UE5.8.4、Visual Studio C++ Build Tools和Windows SDK。新目录克隆固定tag，无需引擎源码、历史Saved、自制地图或Android SDK。已记录桌面设备为RX9070／D3D12 SM6，其他硬件需要自行验证。' : 'The desktop route needs Windows, PowerShell 7, installed UE5.8.4, Visual Studio C++ Build Tools and Windows SDK. Clone the fixed tag into a new directory. No source-engine checkout, historical Saved, authored map or Android SDK is needed. Recorded desktop evidence uses RX9070/D3D12 SM6; other hardware needs its own validation.'}</p>
  <pre tabindex="0" role="region" aria-label={zh ? 'PowerShell命令，可横向滚动' : 'PowerShell commands, horizontally scrollable'}><code>{quickstart}</code></pre>
  <p>{zh ? 'Build编译Development Editor／Win64；Test以NullRHI跑CPU数学自动化，成功报告在Saved/Tests。Run打开固定相机、立柱／细杆与球域雾，High默认全格64步。关闭交互窗口再启动下一GPU任务。打开uproject并Play也会在引擎Entry地图中生成场景。构建成功、CPU通过和看到画面是三个结果。' : 'Build compiles Development Editor/Win64. Test runs CPU math automation with NullRHI, writing under Saved/Tests. Run opens the fixed camera, pillars/thin rods and spherical fog; High defaults to full-grid 64 steps. Close that window before another GPU job. Opening the uproject and pressing Play also generates the scene in the engine Entry map. Build, CPU success and a visible scene are distinct results.'}</p>
  <h3>{zh ? '可选：读回S/T，分别分析两种模型' : 'Optional: read back S/T and analyse each model separately'}</h3>
  <p>{zh ? '数值分析需要Python 3.12、NumPy和Pillow。已有合适环境可把$FogPython设为其解释器；否则按固定requirements在out中建隔离环境：' : 'Analysis needs Python 3.12, NumPy and Pillow. Point $FogPython to a suitable existing interpreter, or create an isolated environment under out using pinned requirements:'}</p>
  <pre tabindex="0" role="region" aria-label={zh ? 'PowerShell命令，可横向滚动' : 'PowerShell commands, horizontally scrollable'}><code>{pythonSetup}</code></pre>
  <p>{zh ? '每次用新目录，Readback拒绝已有目录以防旧数组混入。第一组默认Prescribed／High，scene=fog321×181；第二组显式Manual／Medium guided，scene640×360、fog320×180。模型入口和schema不能互换。' : 'Use a new directory each time: Readback rejects existing outputs to prevent stale arrays. The first case is Prescribed/High, scene=fog321×181; the second is explicit Manual/Medium guided, scene640×360, fog320×180. Their analysis tools and schemas are not interchangeable.'}</p>
  <pre tabindex="0" role="region" aria-label={zh ? 'PowerShell命令，可横向滚动' : 'PowerShell commands, horizontally scrollable'}><code>{numerical}</code></pre>
  <div class="table-wrap" tabindex="0" role="region" aria-label={zh ? '数值字段说明，可横向滚动' : 'Numerical fields, horizontally scrollable'}><table><thead><tr><th scope="col">{zh ? '查看什么' : 'What to read'}</th><th scope="col">{zh ? '含义与预期' : 'Meaning and expectation'}</th></tr></thead><tbody><tr><th scope="row">exit code / passed</th><td>{zh ? '分析CLI应exit 0且顶层passed=true；拒收exit2。保留run.json、run.log、raw/metadata.json、原始数组和分析JSON。' : 'Require analysis exit 0 and top-level passed=true; rejection exits 2. Retain run.json, run.log, raw/metadata.json, raw arrays and analysis JSON.'}</td></tr><tr><th scope="row">runs[].opticalPassed</th><td>{zh ? '以独立解码实际DeviceZ为条件，检查S/T、透射范围和模型；预期true。' : 'Checks S/T, transmission bounds and model conditional on independently decoded actual DeviceZ; expected true.'}</td></tr><tr><th scope="row">strictGeometryPassed / depthScope</th><td>{zh ? 'Diagnostic已知理想盒几何与实际深度有边界差异，strictGeometryPassed可false；不能删去或把optical通过扩大为一般几何正确。' : 'Diagnostic has known boundary differences between ideal boxes and actual depth, so strictGeometryPassed can be false. Preserve it; optical success does not prove general geometry correctness.'}</td></tr><tr><th scope="row">S / T / ST</th><td>{zh ? '未色调映射浮点误差和容差；模型、尺寸、viewMin和preExposure需对应本次manifest。不能替代HDR返回或计时证据。' : 'Untonemapped float errors and tolerances. Match model, sizes, viewMin and preExposure to the new manifest. These are not HDR-return or timing evidence.'}</td></tr></tbody></table></div>
  <p>{zh ? 'DebugLayer／读回用于正确性，不能用于正式性能。公开快照保留Android渲染源码，但没有全部历史归档采集／聚合driver；这些桌面步骤不等于重跑真机质量或成本矩阵。Android重建另需工具链、cook、目标设备和独立验证。' : 'Debug-layer/readback runs check correctness, not formal performance. The public snapshot retains Android rendering source but not every historical archive-collection/aggregation driver. These desktop commands do not rerun the phone matrix; Android rebuilding also needs its toolchain, cook, device and independent validation.'}</p>
  <p><a id="source-quickstart" href={uefoglab.source.quickstart}>{zh ? '固定tag完整QUICKSTART' : 'Full QUICKSTART at the fixed tag'}</a> · <a href={source+'tools/fog_analysis.py'}>Prescribed analysis</a> · <a href={source+'tools/fog_m2_analysis.py'}>Manual analysis</a></p>
 </section>
 <section class="wrap fog-section" id="limits">
  <p class="eyebrow">08 / LIMITS, NEXT QUESTIONS &amp; SOURCES</p><h2>{zh ? '已回答的问题，和下一轮仍需验证的取舍' : 'What is established, and what the next iteration must test'}</h2>
  <p>{zh ? '当前形成简单介质的积分→深度引导重建→线性HDR闭环，并解释固定真机的质量与成本。后续可研究减少重建开销、增加遮挡覆盖采样或局部全格回退；这些是待测方向，不是已实现优化。' : 'The current result is an inspectable integration→depth-guided reconstruction→linear HDR path for simple media, with quality and cost on one phone. Future work could reduce reconstruction cost, add occluder-coverage samples or use local full-grid fallback. These are hypotheses to test, not implemented optimizations.'}</p>
  <ul><li>{zh ? '一般场景／尺寸、真实非零ViewRect、桌面正式性能、移动Manual、运动／时域和跨设备支持未验收。' : 'General scenes/sizes, actual nonzero ViewRect, desktop formal timing, mobile Manual, motion/temporal behaviour and cross-device support remain unverified.'}</li><li>{zh ? '历史启动SIGSEGV根因未定；成功重试不是稳定性修复。whole-frame、FPS、能耗和硬件瓶颈无测量结论。' : 'Historical startup SIGSEGV root cause is unresolved; retries do not establish a stability fix. Whole-frame, FPS, energy and hardware-bottleneck conclusions remain unavailable.'}</li><li>{zh ? '历史展示用5.8.2，新干净桌面复现与移动实验用5.8.4。质量与计时APK分开，不能把旧真机运行改贴为公开tag的新回执。' : 'Historical display media use 5.8.2; fresh clean-source desktop reproduction and mobile studies use 5.8.4. Quality/timing APKs remain separate. Old phone runs are not relabelled as current-tag receipts.'}</li></ul>
  <details><summary>{zh ? '版本化证据、来源与许可' : 'Versioned evidence, provenance and licence'}</summary><p>{zh ? '历史M5作者和独立者在两个干净项目目录完成5.8.4构建／CPU与Prescribed／Manual新光学检查，8份历史核心数组同字节；引擎／DDC可复用，不称全冷缓存。光学以实际深度为条件，理想几何差异仍保留。内部历史不随独立公开Git发布；精简结果保存身份与SHA。' : 'Historical M5 author/reviewer work used two clean directories for 5.8.4 builds/CPU and new Prescribed/Manual optical checks; eight core arrays matched. Engine/DDC reuse was allowed, so this is not cold-cache evidence. Optics remain conditional on actual depth, with ideal-geometry differences retained. Internal history is not bundled with public Git; compact data retain identities and hashes.'}</p><p><a href={source+'docs/showcase/evidence/summary.md'}>{zh ? '公开证据摘要' : 'Public evidence summary'}</a> · <a href={media+'results.json'}>{zh ? '精简数值' : 'Compact results'}</a> · <a href={media+'manifest.json'}>{zh ? '媒体SHA' : 'Media SHA manifest'}</a> · <a href={media+'provenance.json'}>{zh ? '来源映射' : 'Provenance'}</a> · <a href={source+'docs/theory/README.md'}>{zh ? '一手参考索引' : 'Primary reference index'}</a></p><p>{zh ? '可授权原创代码、自写文档与图表采用MIT（2026 xiaoran6657）；UE和第三方保留各自条款。实验图／视频保留原字节；新增流程／采样图是教学示意。Coding agents辅助开发、实验和独立审查；发布、独立验证与本人学习／掌握程度分别记录。' : 'Owner-authorizable original code, self-written documents and figures use MIT(2026 xiaoran6657); UE and third-party rights remain reserved. Experimental media retain their bytes; new diagrams are instructional. Coding agents assisted implementation, experiments and review; publication, validation and owner learning/mastery remain separate states.'}</p><p><a href={uefoglab.source.license}>MIT</a> · <a href={uefoglab.source.notice}>NOTICE</a></p></details>
