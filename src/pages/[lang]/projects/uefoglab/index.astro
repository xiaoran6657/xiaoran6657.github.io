---
import Layout from '../../../../layouts/Layout.astro';
import { languages, type Lang } from '../../../../data/profile';
import { uefoglab } from '../../../../data/uefoglab';
export function getStaticPaths() { return languages.map(lang => ({ params: { lang } })); }
const lang = Astro.params.lang as Lang;
const zh = lang === 'zh';
const r = uefoglab.results;
const modes = r.mobile.timing.modes.filter(row => row.name !== 'Off');
const quality = [
  { key: 'planeWholeTRMSE', zh: 'Planes 整体 T RMSE', en: 'Planes whole-image T RMSE' },
  { key: 'planeStepTRMSE', zh: 'plane-step ROI T RMSE', en: 'plane-step ROI T RMSE' },
  { key: 'nearSkyTRMSE', zh: 'near-sky ROI T RMSE', en: 'near-sky ROI T RMSE' },
  { key: 'planeWholeHDRBlueRMSE', zh: 'Planes 整体 HDR Blue RMSE', en: 'Planes whole-image HDR Blue RMSE' },
  { key: 'thinHitTMAE', zh: 'ThinStripe thin-hit T MAE', en: 'ThinStripe thin-hit T MAE' },
] as const;
const media = '/media/uefoglab/';
---
<Layout lang={lang} title={'UEFogLab · ' + uefoglab.subtitle[lang]} description={uefoglab.summary[lang]} path="projects/uefoglab/">
  <header class="wrap page-intro fog-intro">
    <p class="eyebrow">04 / UE 5.8 · LOCAL FOG</p><h1>UEFogLab</h1>
    <p class="lede">{uefoglab.subtitle[lang]}</p><p>{uefoglab.summary[lang]}</p>
    <div class="tag-row"><span>{uefoglab.status[lang]}</span><span>C++ / HLSL</span><span>Full64 / High</span></div>
    <div class="fog-links"><a id="source-repository" class="button button-outline" href={uefoglab.source.repository}>{zh ? '公开源码' : 'Public source'} ↗</a><a id="source-version" class="button button-outline" href={uefoglab.source.tag}>{uefoglab.source.version} ↗</a></div>
    <nav class="fog-nav" aria-label={zh ? '案例章节' : 'Case sections'}>
      <a href="#method">{zh ? '实现路径' : 'Method'}</a><a href="#quality">{zh ? '重建' : 'Reconstruction'}</a><a href="#native">{zh ? '原生对照' : 'Native comparison'}</a><a href="#mobile">{zh ? '真机成本' : 'Mobile cost'}</a><a href="#limits">{zh ? '复现与限制' : 'Reproduction & limits'}</a>
    </nav>
  </header>
  <section class="wrap fog-section" aria-labelledby="edit-title">
    <h2 id="edit-title">{zh ? '48 秒静帧展示剪辑' : 'A 48-second still-image showcase edit'}</h2>
    <p id="fog-video-note">{zh ? '六张静帧各 8 秒，无音轨。24fps 只是编码属性，不是实时录屏、GPU FPS 或运动稳定性证据。无需播放也可阅读下面的图表和结论。' : 'Six still slides, eight seconds each, no audio. 24fps is an encoding property, not measured FPS, real-time footage or motion evidence. The figures and results remain readable without playing the video.'}</p>
    <video controls preload="none" poster={media + 'cover.png'} width="1280" height="720" aria-describedby="fog-video-note"><source src={media + 'showcase.mp4'} type="video/mp4" /><a href={media + 'showcase.mp4'}>{zh ? '下载静帧剪辑' : 'Download the still-image edit'}</a></video>
    <p class="fog-caption">{zh ? '封面为 UE5.8.2 / RX9070 的实际 Manual HG Full64 静帧，加说明文字；历史显示素材保留原版本。开发、实验执行和独立审查由 coding agents 辅助，本人学习与技术掌握程度另行确认。' : 'The captioned cover derives from an actual UE5.8.2 / RX9070 Manual HG Full64 still. Historical display media keep their original identities. Coding agents assisted implementation, execution and independent review; owner study and technical mastery are tracked separately.'}</p>
  </section>
  <section class="wrap fog-section" id="method">
    <p class="eyebrow">01 / METHOD</p><h2>{zh ? '分别检验积分、重建与合成' : 'Check integration, reconstruction and composition separately'}</h2>
    <div class="fog-flow">
      <div><span>01</span><h3>{zh ? '深度裁剪 / 积分' : 'Depth clipping / integration'}</h3><p>{zh ? '固定球域介质，按不透明深度截断射线；以 m⁻¹ 消光和 cm 几何显式换算，输出未曝光 S.rgb 与 T。' : 'Clip sphere rays at opaque depth, convert centimetres to metres explicitly, and integrate unexposed S.rgb and T.'}</p></div>
      <div><span>02</span><h3>{zh ? '重建 S/T' : 'Reconstruct S/T'}</h3><p>{zh ? '场景和雾格保持独立；用双线性或深度相容权重重建，保留低格漏采与 fallback 的反例。' : 'Keep scene and fog grids independent. Reconstruct with bilinear or depth-compatible weights, retaining low-grid misses and fallback failures.'}</p></div>
      <div><span>03</span><h3>{zh ? '线性 HDR 合成' : 'Linear HDR composition'}</h3><p><code>Cout = P * S + T * Cin</code><br />{zh ? 'P 为 PreExposure，Cin 已是引擎预曝光场景色；数值读回、截图和计时分开验证。' : 'P is PreExposure; Cin is already pre-exposed engine scene color. Numerics, screenshots and timing have separate checks.'}</p></div>
    </div>
    <p>{zh ? 'Prescribed 使用固定 J=(.35,.60,.90)。显式 Manual HG 使用手动方向、albedo 与归一化 HG，相机射线上的 J 恒定，入射光路透射/可见性固定为 1。两模型都没有 UE 自动取光、光源路径衰减、体积阴影、多次散射、透明整合或自研时域重建。移动实测仅为 Uniform Prescribed。' : 'Prescribed fixes J=(.35,.60,.90). Explicit Manual HG uses a manual direction, albedo and normalized HG, with ray-constant J and incoming transmittance/visibility fixed to one. Neither custom model adds UE light extraction, incoming-path attenuation, volume shadows, multiple scattering, transparency integration or temporal reconstruction. Mobile evidence is Uniform Prescribed only.'}</p>
  </section>
  <section class="wrap fog-section" id="quality">
    <p class="eyebrow">02 / SAME-MODEL QUALITY</p><h2>{zh ? '引导重建改善边缘，仍保留局部退化' : 'Guidance improves many edges, with local regressions retained'}</h2>
    <figure><a href={media + 'reconstruction-triptych.png'}><img src={media + 'reconstruction-triptych.png'} width="1280" height="500" loading="lazy" alt={zh ? '固定 T 范围下 High Full64、Half64 bilinear 与 guided 的并排图' : 'High Full64, Half64 bilinear and guided T panels on one fixed display scale'} /></a><figcaption>{zh ? '历史 UE5.8.2 / RX9070 / D3D12 SM6，Prescribed/radial，scene640×360、full640×360 / half320×180、64步，修复源0881f5b。T显示范围[0,1]，裁自同模型原图并统一缩放。Reference只在冻结夹具的收敛范围内使用，不是普遍物理真值。' : 'Historical UE5.8.2 / RX9070 / D3D12 SM6, Prescribed/radial, scene640×360, full640×360 / half320×180,64steps, repair source0881f5b. Fixed T range[0,1], uniformly resized crops. Reference convergence is bounded to frozen cases, not universal physical truth.'}</figcaption></figure>
    <details><summary>{zh ? '查看原始 S/T 图及保留的反例' : 'Open the original S/T sheet and retained counterexamples'}</summary><figure><a href={media + 'desktop-st.png'}><img src={media + 'desktop-st.png'} width="1920" height="2304" loading="lazy" alt={zh ? '修复后的 Prescribed 同模型 S/T 和固定误差显示原图' : 'Repaired Prescribed S/T and fixed-scale error sheet'} /></a></figure><p><a href={media + 'desktop-counterexample.png'}>{zh ? '同模型局部反例原图 ↗' : 'Same-model local counterexample ↗'}</a></p><figure><a href={media + 'native-edge.png'}><img src={media + 'native-edge.png'} width="2080" height="1260" loading="lazy" alt={zh ? 'Manual 显示边缘的完整固定 ROI 与 guided 局部退化' : 'Full fixed Manual display ROI and a local guided regression'} /></a><figcaption>{zh ? 'UE5.8.2/RX9070，Manual HG，scene1280×720/half640×360/64步，源7730eba。采后说明性选点(799,411)对 High 的最大RGB码差B=0、G=2。High是显示基线，码值差不等于S/T精度；不保证每个像素改善。' : 'UE5.8.2/RX9070, Manual HG, scene1280×720/half640×360/64steps,source7730eba. At post-capture illustrative point(799,411), max RGB-code difference from High is B=0,G=2. High is a display baseline, not an S/T oracle; every-pixel improvement is not guaranteed.'}</figcaption></figure></details>
  </section>
  <section class="wrap fog-section" id="native">
    <p class="eyebrow">03 / NATIVE FEATURES</p><h2>{zh ? '先说明模型差异，再比较画面' : 'Read the model differences before comparing images'}</h2>
    <figure><a href={media + 'native-comparison.png'}><img src={media + 'native-comparison.png'} width="2640" height="1050" loading="lazy" alt={zh ? 'Off、自研Manual、standalone LFV和LFV注入VF的历史固定静态矩阵' : 'Historical fixed static matrix of Off, custom Manual, standalone LFV and LFV injected into VF'} /></a><figcaption>{zh ? 'UE5.8.2/RX9070/D3D12 SM6，1280×720、手动曝光、共同无阴影场景，捕获7730eba；Ours为Manual HG，albedo.8/g.5/E(4,3,2)/归一化k(-1,-1,.15)，Full1280×720/Half640×360、64步。原生不是同模型数值真值，也不作性能排名。' : 'UE5.8.2/RX9070/D3D12 SM6,1280×720,manual exposure,common unshadowed scene,capture7730eba. Ours uses Manual HG,albedo.8/g.5/E(4,3,2)/normalized k(-1,-1,.15),Full1280×720/Half640×360,64steps. Native images are not a common-model numerical oracle or performance ranking.'}</figcaption></figure>
    <div class="table-wrap" tabindex="0"><table><thead><tr><th>{zh ? '路径' : 'Path'}</th><th>{zh ? '密度/照明/时间差异' : 'Density / lighting / time differences'}</th></tr></thead><tbody><tr><th scope="row">Ours Manual HG</th><td>{zh ? '四次径向消光、相对手动E，无UE取光或历史。' : 'Quartic radial extinction, relative manual E, no UE light extraction or history.'}</td></tr><tr><th scope="row">LFV standalone</th><td>{zh ? '原生径向归一化与height8覆盖门、原生照明单位。' : 'Native radial normalization and height8 coverage gate; native light units.'}</td></tr><tr><th scope="row">LFV → VF</th><td>{zh ? '不同密度形状，160×90×128体素、灯光与TR on/off；静态观察不证明运动稳定。' : 'Different density shape,160×90×128voxels,lighting and TR on/off; static observations do not establish motion stability.'}</td></tr></tbody></table></div>
  </section>
  <section class="wrap fog-section" id="mobile">
    <p class="eyebrow">04 / MOBILE QUALITY &amp; COST</p><h2>{zh ? '这个场景中，重建成本超过积分节省' : 'Reconstruction outweighs integration savings in this fixture'}</h2>
    <p>{zh ? 'UE5.8.4/CL58902052，MEIZU21/Adreno750，Vulkan ES3_1 Mobile Forward HDR，MSAA1/保留native depth/ViewMin0。Uniform Prescribed64、sigma.35m⁻¹、P1，scene1552×720，Full1552×720/Half776×360。质量源36724b7与Development计时nativefea3f13/hostfd7e335分属不同APK；计时夹具为Planes。' : 'UE5.8.4/CL58902052,MEIZU21/Adreno750,Vulkan ES3_1 Mobile Forward HDR,MSAA1/retained native depth/ViewMin0. Uniform Prescribed64,sigma.35m⁻¹,P1,scene1552×720,Full1552×720/Half776×360. Quality source36724b7 and Development timing nativefea3f13/hostfd7e335 use separate APKs; timing fixture is Planes.'}</p>
    <p class="fog-caption">{zh ? '窄屏可横向滚动表格查看完整数值；点击图片可查看原尺寸。' : 'Scroll tables horizontally on narrow screens to read every value; open figures for their original size.'}</p>
    <div class="table-wrap" tabindex="0" aria-label={zh ? '可横向滚动的GPU成本表' : 'Horizontally scrollable GPU cost table'}><table><thead><tr><th>{zh ? '模式' : 'Mode'}</th><th>FogTotal ms</th><th>{zh ? '四trial中位数范围' : 'Range of four medians'}</th><th>{zh ? '独立block p50' : 'Independent-block p50'}</th></tr></thead><tbody>{modes.map(row => <tr><th scope="row">{row.name}</th><td>{row.FogTotal.medianOfTrialMediansMs.toFixed(6)}</td><td>{row.FogTotal.rangeOfTrialMediansMs.map(x => x.toFixed(6)).join('–')}</td><td>{row.freshFogTotalMs.toFixed(6)}</td></tr>)}</tbody></table></div>
    <p class="fog-caption">{zh ? '四个trial p50的中位数及min–max；作者16trial/7708帧（含Off），独立完整block4trial/1925帧。范围不是置信区间。BOP FogTotal含marker/barrier及当前Full R32 guide，插桩会扰动调度；子scope中位数不必相加成总中位数。whole GPU frame、FPS、能耗不可用；频率不可读，电池温度仅代理，不证明恒频。' : 'Median and min–max of four trial p50s; author16trials/7708frames including Off,independent complete block4trials/1925frames. Ranges are not confidence intervals. BOP FogTotal includes marker/barrier and current Full R32-guide cost; instrumentation perturbs scheduling. Component medians need not sum to the total. Whole GPU frame,FPS and energy are unavailable; frequency is unreadable and battery temperature is only a proxy.'}</p>
    <figure><a href={media + 'mobile-cost-quality.png'}><img src={media + 'mobile-cost-quality.png'} width="1280" height="620" loading="lazy" alt={zh ? 'Full约0.651ms、HalfB约0.918ms、HalfG约1.144ms，与独立质量包约0.428的thin-hit T MAE' : 'Full about0.651ms,HalfB0.918ms,HalfG1.144ms,with about0.428thin-hit T MAE from the separate quality APK'} /></a></figure>
    <div class="table-wrap" tabindex="0"><table><thead><tr><th>{zh ? '相对actual Full64的独立质量包' : 'Separate quality APK versus actual Full64'}</th><th>HalfB64</th><th>HalfG64</th></tr></thead><tbody>{quality.map(item => <tr><th scope="row">{item[lang]}</th><td>{r.mobile.quality.rows.HalfB64[item.key].toFixed(9)}</td><td>{r.mobile.quality.rows.HalfG64[item.key].toFixed(9)}</td></tr>)}</tbody></table></div>
    <p>{zh ? '实际Full是同模型/同档参照，不表示物理误差为零。Guided在上述Planes误差更低，但ThinStripe的120个Full命中在低格canonical采样中命中0个，HalfG全部走零兼容fallback。固定thin-hit ROI=[1000,300,1001,420)。全图预算通过不能恢复丢失几何，Full保持默认。' : 'Actual Full is a same-model reference, not zero physical error. Guidance reduces the listed Planes errors, yet ThinStripe has120Full hits and0low-grid canonical hits, with all120guided queries taking zero-compatible fallback. Fixed thin-hit ROI=[1000,300,1001,420). Passing global budgets does not recover missing geometry; Full stays the default.'}</p>
    <figure><a href={media + 'mobile-thin-roi.png'}><img src={media + 'mobile-thin-roi.png'} width="1800" height="1200" loading="lazy" alt={zh ? 'ThinStripe实际GPU guide、Full T、低格漏采和fallback诊断原图' : 'Actual ThinStripe GPU guide,Full T,low-grid miss and fallback diagnostics'} /></a></figure>
    <p><a href={media + 'mobile-planes-roi.png'}>{zh ? '查看Planes冻结ROI原图 ↗' : 'Open the frozen Planes ROI figure ↗'}</a></p>
  </section>
  <section class="wrap fog-section" id="limits">
    <p class="eyebrow">05 / REPRODUCTION &amp; LIMITS</p><h2>{zh ? '可复现的范围，也有明确的未完成项' : 'A reproducible scope with explicit remaining work'}</h2>
    <p>{zh ? '新的UE5.8.4干净项目目录重建、CPU与Prescribed/Manual两条GPU路径由作者和独立者分别完成，8份历史核心数组同字节；引擎/DDC缓存允许复用，不称全冷缓存。Diagnostic光学以独立解码实际深度为条件，理想几何差异仍保留。原创代码、自写文档和图表采用MIT（2026 xiaoran6657），UE及第三方保留各自条款；源码已公开为固定版本 v0.1.0-preview.1。' : 'Author and independent reviewer used separate clean project directories for new UE5.8.4 builds,CPU and Prescribed/Manual GPU paths; eight historical core arrays match. Engine/DDC caches may be reused,so these are not cold-cache builds. Diagnostic optical checks are conditional on independently decoded actual depth; ideal-geometry differences remain. Original code, self-written documents and figures use MIT (2026 xiaoran6657); UE and third-party rights remain reserved. Source is public at the fixed v0.1.0-preview.1 tag.'}</p>
    <p>{zh ? '未验收一般场景/尺寸、真实非零ViewRect、桌面正式性能、移动Manual、运动/时域与跨设备支持。历史启动SIGSEGV根因未定；成功重试不等于稳定性修复。优化按实测后续迭代，启动稳定性单列调查。Agent实现/独立审查、发布与本人学习是分别记录的状态。' : 'General scenes/sizes,actual nonzero ViewRect,desktop formal timing,mobile Manual,motion/temporal behavior and cross-device support remain unverified. Historical startup SIGSEGV root cause is unresolved; successful retries do not establish stability. Optimization follows measurements; startup investigation is separate. Agent implementation/review,publication and owner learning remain separate states.'}</p>
    <p><a id="source-quickstart" href={uefoglab.source.quickstart}>{zh ? '固定版本启动与复现说明' : 'Pinned quickstart & reproduction'} ↗</a> · <a href={uefoglab.source.license}>MIT</a> · <a href={uefoglab.source.notice}>NOTICE</a></p>
    <div class="fog-links"><a class="button button-outline" href={media + 'results.json'}>{zh ? '读取精简结果与来源' : 'Read compact results & provenance'} ↗</a><a class="button button-outline" href={media + 'manifest.json'}>{zh ? '查看媒体SHA清单' : 'View media SHA manifest'} ↗</a><a class="button button-outline" href={media + 'provenance.json'}>{zh ? '读取技术来源映射' : 'Read technical provenance'} ↗</a></div>
  </section>
</Layout>
<style>
  .fog-intro>p:not(.eyebrow){max-width:80ch}.fog-intro .tag-row{margin-top:1.4rem}.fog-nav,.fog-links{display:flex;gap:1.2rem;flex-wrap:wrap;margin-top:1.8rem}.fog-nav a{border-bottom:1px solid var(--line)}.fog-section{padding-block:2.8rem;border-top:1px solid var(--line)}.fog-section h2{margin:.5rem 0 1.4rem}.fog-section p{max-width:96ch}.fog-section video{margin-top:1.5rem;border:1px solid var(--line);border-radius:12px;background:#101820}.fog-caption,figcaption{font-size:.88rem;color:var(--muted);line-height:1.8;margin-top:1rem}.fog-flow{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;margin:1.7rem 0}.fog-flow>div{border:1px solid var(--line);border-radius:10px;padding:1.4rem;background:var(--surface)}.fog-flow span{font-size:.8rem;color:var(--muted)}.fog-flow h3{font-size:1.15rem;margin:.7rem 0}figure{margin:1.7rem 0}figure img{width:100%;height:auto;border:1px solid var(--line);border-radius:10px}details{border:1px solid var(--line);border-radius:10px;padding:1rem;margin-top:1.5rem}summary{cursor:pointer;font-weight:600}.table-wrap{max-width:100%;overflow-x:auto;border:1px solid var(--line);border-radius:10px;margin:1.7rem 0}table{border-collapse:collapse;width:100%;min-width:620px;font-size:.9rem}th,td{padding:.9rem 1.1rem;border-bottom:1px solid var(--line);text-align:left}thead{background:var(--surface-2)}td{font-variant-numeric:tabular-nums}code{font-size:.85em;overflow-wrap:anywhere}.fog-section>a,.fog-section p>a{text-decoration:underline}@media(max-width:760px){.fog-flow{grid-template-columns:1fr}.fog-section{padding-block:2rem}.fog-nav{gap:.8rem}.fog-links .button{width:100%;text-align:center}}
</style>
