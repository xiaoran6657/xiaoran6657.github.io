---
import Layout from '../layouts/Layout.astro';
import LumaBoughFeature from './LumaBoughFeature.astro';
import BattleWallFeature from './BattleWallFeature.astro';
import ProjectFeature from './ProjectFeature.astro';
import CaseCards from './CaseCards.astro';
import { profile, type Lang } from '../data/profile';
const { lang, redirectRoot = false } = Astro.props as { lang: Lang; redirectRoot?: boolean };
const zh = lang === 'zh';
---
<Layout lang={lang} redirectRoot={redirectRoot}>
  <section class="hero wrap">
    <div class="hero-main">
      <p class="eyebrow"><span class="accent-line"></span>{profile.role[lang]}</p>
      <h1>{zh ? <>从游戏交互，<br />走向<span class="highlight">渲染与验证。</span></> : <>Game interactions.<br /><span class="highlight">Rendering. Verification.</span></>}</h1>
    </div>
    <div class="hero-aside">
      <p>{profile.bio[lang]}</p>
      <a class="text-link" href="#selected-work">{zh ? '查看精选作品' : 'View selected work'} <span aria-hidden="true">↓</span></a>
    </div>
  </section>
  <section class="wrap section" id="selected-work">
    <div class="section-heading"><p class="eyebrow">{zh ? 'SELECTED WORK / 精选作品' : 'SELECTED WORK'}</p><span class="muted">03</span></div>
    <ProjectFeature lang={lang} /><BattleWallFeature lang={lang} /><LumaBoughFeature lang={lang} />
  </section>
  <section class="wrap section cases-section">
    <div class="section-heading"><div><p class="eyebrow">INSIDE XUILAB</p><h2>{zh ? '三个问题，三条探索路径。' : 'Three questions. Three explorations.'}</h2></div><a class="text-link" href={'/' + lang + '/projects/xuilab/'}>{zh ? '项目概览' : 'Project overview'} <span aria-hidden="true">↗</span></a></div>
    <CaseCards lang={lang} />
  </section>
  <section class="wrap about-strip">
    <p class="eyebrow">{zh ? '关于 / ABOUT' : 'ABOUT'}</p>
    <h2>{zh ? '对交互与渲染保持好奇，\n用工程方法寻找答案。' : 'Curious about the details.\nMethodical about the answers.'}</h2>
    <a class="button button-outline" href={'/' + lang + '/about/'}>{zh ? '了解更多' : 'More about me'} <span aria-hidden="true">↗</span></a>
  </section>
</Layout>
